@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password – CTUG Clearance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background:#f4f6f8; font-family:'Segoe UI',sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .card { background:white; border-radius:14px; padding:36px; width:100%; max-width:420px; box-shadow:0 4px 24px rgba(0,0,0,0.08); }
        .card-header-bar { background:#1a4731; border-radius:10px; padding:18px 22px; margin-bottom:24px; text-align:center; }
        .input-field { width:100%; padding:11px 14px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; outline:none; transition:border-color .2s; }
        .input-field:focus { border-color:#1a4731; box-shadow:0 0 0 3px rgba(26,71,49,.1); }
        .btn-main { width:100%; background:#1a4731; color:white; border:none; border-radius:8px; padding:12px; font-size:14px; font-weight:700; cursor:pointer; }
        .btn-main:hover { opacity:.88; }
    </style>
</head>
<body>
<div class="card">
    <div class="card-header-bar">
        <i class="fas fa-key" style="color:white;font-size:22px;display:block;margin-bottom:8px;"></i>
        <div style="font-size:16px;font-weight:700;color:white;">Set New Password</div>
    </div>

    @if (TempData["ResetError"] != null)
    {
        <div class="alert alert-danger" style="font-size:13px;">@TempData["ResetError"]</div>
    }

    <form method="post" asp-action="ResetPassword" asp-controller="Home">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@ViewBag.Token" />
        <div style="margin-bottom:16px;">
            <label style="font-size:12px;font-weight:700;color:#555;display:block;margin-bottom:5px;">New Password</label>
            <input type="password" name="password" class="input-field" placeholder="Enter new password" required minlength="6" />
        </div>
        <button type="submit" class="btn-main">
            <i class="fas fa-check me-2"></i>Reset Password
        </button>
    </form>
</div>
</body>
</html>
