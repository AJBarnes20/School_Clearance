@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
    bool otpSent     = TempData["ForgotOtpSent"]?.ToString() == "true";
    bool otpVerified = TempData["ForgotVerified"]?.ToString() == "true";
    string savedEmail = TempData["ForgotEmail"]?.ToString() ?? "";
    string verToken   = TempData["ForgotToken"]?.ToString()  ?? "";

    string stepTitle = otpVerified ? "Set New Password"
                     : otpSent     ? "Enter Verification Code"
                                   : "Forgot Password";
    string stepSub   = otpVerified ? "Create a new password for your account"
                     : otpSent     ? "Enter the 6-digit code sent to your email"
                                   : "Enter your email to receive a verification code";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password – CTUG Clearance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background:#f4f6f8; font-family:'Segoe UI',sans-serif; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .card { background:white; border-radius:14px; padding:36px; width:100%; max-width:420px; box-shadow:0 4px 24px rgba(0,0,0,0.08); }
        .card-header-bar { background:#1a4731; border-radius:10px; padding:18px 22px; margin-bottom:24px; text-align:center; }
        .input-field { width:100%; padding:11px 14px; border:1px solid #d1d5db; border-radius:8px; font-size:14px; outline:none; transition:border-color .2s; font-family:inherit; box-sizing:border-box; }
        .input-field:focus { border-color:#1a4731; box-shadow:0 0 0 3px rgba(26,71,49,.1); }
        .otp-field { letter-spacing:10px; font-size:22px; font-weight:700; text-align:center; }
        .btn-main { width:100%; background:#1a4731; color:white; border:none; border-radius:8px; padding:12px; font-size:14px; font-weight:700; cursor:pointer; transition:opacity .2s; font-family:inherit; }
        .btn-main:hover { opacity:.88; }
        .lbl { font-size:12px; font-weight:700; color:#555; display:block; margin-bottom:5px; }
        .step-indicator { display:flex; justify-content:center; gap:8px; margin-bottom:20px; }
        .step-dot { width:10px; height:10px; border-radius:50%; background:#d1d5db; }
        .step-dot.active { background:#1a4731; }
        .step-dot.done   { background:#28a745; }
    </style>
</head>
<body>
<div class="card">
    <div class="card-header-bar">
        <i class="fas fa-@(otpVerified ? "key" : otpSent ? "shield-halved" : "lock")"
           style="color:white;font-size:22px;display:block;margin-bottom:8px;"></i>
        <div style="font-size:16px;font-weight:700;color:white;">@stepTitle</div>
        <div style="font-size:12px;color:rgba(255,255,255,.7);margin-top:4px;">@stepSub</div>
    </div>

    <!-- Step indicators -->
    <div class="step-indicator">
        <div class="step-dot @(otpSent || otpVerified ? "done" : "active")"></div>
        <div class="step-dot @(otpVerified ? "done" : otpSent ? "active" : "")"></div>
        <div class="step-dot @(otpVerified ? "active" : "")"></div>
    </div>

    @if (TempData["ForgotError"] != null)
    {
        <div class="alert alert-danger" style="font-size:13px;border-radius:8px;">
            <i class="fas fa-exclamation-circle me-1"></i>@TempData["ForgotError"]
        </div>
    }

    @if (!otpSent && !otpVerified)
    {
        <!-- STEP 1: Enter email -->
        <form method="post" asp-action="ForgotPassword" asp-controller="Home">
            @Html.AntiForgeryToken()
            <div style="margin-bottom:16px;">
                <label class="lbl">Email Address</label>
                <input type="email" name="email" class="input-field"
                       placeholder="Enter your registered email" required autofocus />
            </div>
            <button type="submit" class="btn-main">
                <i class="fas fa-paper-plane me-2"></i>Send Verification Code
            </button>
        </form>
    }
    else if (otpSent && !otpVerified)
    {
        <!-- STEP 2: Enter OTP -->
        <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:8px;padding:10px 14px;margin-bottom:20px;font-size:13px;color:#2e7d32;">
            <i class="fas fa-envelope-open-text me-1"></i>
            Code sent to <strong>@savedEmail</strong>. Expires in 10 minutes.
        </div>

        <form method="post" asp-action="VerifyForgotOtp" asp-controller="Home">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@savedEmail" />
            <div style="margin-bottom:20px;">
                <label class="lbl">Verification Code</label>
                <input type="text" name="otp" class="input-field otp-field"
                       maxlength="6" placeholder="000000" required autofocus
                       inputmode="numeric" pattern="[0-9]{6}" />
            </div>
            <button type="submit" class="btn-main">
                <i class="fas fa-check me-2"></i>Verify Code
            </button>
        </form>

        <div style="text-align:center;margin-top:12px;">
            <a href="/Home/ForgotPassword" style="font-size:13px;color:#1a4731;text-decoration:none;">
                <i class="fas fa-redo me-1"></i>Resend code
            </a>
        </div>
    }
    else if (otpVerified)
    {
        <!-- STEP 3: Set new password -->
        <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:8px;padding:10px 14px;margin-bottom:20px;font-size:13px;color:#2e7d32;">
            <i class="fas fa-check-circle me-1"></i>
            Code verified! Now set your new password.
        </div>

        <form method="post" asp-action="ResetWithOtp" asp-controller="Home">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@verToken" />
            <div style="margin-bottom:20px;">
                <label class="lbl">New Password</label>
                <div style="position:relative;">
                    <input type="password" name="password" id="pw-field" class="input-field"
                           placeholder="Enter new password" required minlength="6"
                           style="padding-right:42px;" autofocus />
                    <button type="button" onclick="togglePw()"
                            style="position:absolute;right:12px;top:50%;transform:translateY(-50%);
                                   background:none;border:none;cursor:pointer;color:#aaa;font-size:14px;padding:0;">
                        <i id="pw-icon" class="fas fa-eye-slash"></i>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn-main">
                <i class="fas fa-save me-2"></i>Save New Password
            </button>
        </form>
    }

    <div style="text-align:center;margin-top:18px;">
        <a href="/Home/Login" style="font-size:13px;color:#1a4731;text-decoration:none;">
            <i class="fas fa-arrow-left me-1"></i>Back to Login
        </a>
    </div>
</div>
<script>
function togglePw() {
    const f = document.getElementById('pw-field');
    const i = document.getElementById('pw-icon');
    f.type = f.type === 'password' ? 'text' : 'password';
    i.className = f.type === 'text' ? 'fas fa-eye' : 'fas fa-eye-slash';
}
</script>
</body>
</html>
