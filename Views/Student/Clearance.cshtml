@* ═══════════════════════════════════════════════════════════════════════════
   Views/Student/Clearance.cshtml  — Unified Subject + Organization Clearance
   ═══════════════════════════════════════════════════════════════════════════ *@
@model OnlineClearanceSystem.Models.StudentClearanceViewModel
@using OnlineClearanceSystem.Models
@{
    ViewData["Title"]      = "Clearance";
    ViewData["ActivePage"] = "Clearance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    bool hasSubjects = Model?.SubjectItems != null && Model.SubjectItems.Any();
    var availableSubjects = ViewBag.AvailableSubjects as IEnumerable<SubjectItem> ?? Enumerable.Empty<SubjectItem>();
    var  adviser     = Model?.ClassAdviser;
}

@Html.AntiForgeryToken()

@* ── Alerts ── *@
@if (TempData["OrgSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["OrgSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["OrgError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["OrgError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- HEADER ROW -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0" style="color:#1a1a2e;font-size:15px;"></h5>

    <!-- PERIOD SELECTOR DROPDOWN -->
    <div class="period-selector-wrap" id="period-wrap">
        <button class="period-btn" id="period-btn" onclick="togglePeriodDd(event)" type="button">
            <div class="period-btn-icon"><i class="fas fa-calendar-alt"></i></div>
            <div class="period-btn-text">
                <div class="period-btn-label">Academic Period</div>
                <div class="period-btn-value" id="period-btn-value">
                    @(ViewData["ActivePeriod"]?.ToString() ?? "Loading...")
                </div>
            </div>
            <i class="fas fa-chevron-down period-chevron"></i>
        </button>

        <div class="period-dd" id="period-dd">
            <div class="pd-loading" id="pd-loading">
                <i class="fas fa-spinner fa-spin me-2"></i>Loading periods...
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   SECTION 1 — SUBJECT CLEARANCE
   ══════════════════════════════════════════════════════════════════════════ *@

<!-- ADD SUBJECT PANEL (step 1: search & select) -->
<div id="add-subject-panel" style="display:none;" class="page-card mb-3">
    <div class="page-card-hd dark" style="justify-content:space-between;display:flex;align-items:center;">
        <span><i class="fas fa-plus-circle me-2"></i>Add Subjects</span>
        <button onclick="closeAddPanel()" style="background:rgba(255,255,255,0.15);border:none;color:white;border-radius:6px;padding:4px 12px;font-size:12px;cursor:pointer;"><i class="fas fa-times me-1"></i>Close</button>
    </div>
    <div id="add-step-select">
        <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;">
            <div class="search-wrap" style="position:relative;flex:1;max-width:500px;">
                <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#aaa;font-size:13px;"></i>
                <input type="text" id="subject-search"
                       placeholder="Search by MIS code, subject or instructor…"
                       autocomplete="off" oninput="onSearchInput(this.value)"
                       style="width:100%;padding:9px 12px 9px 36px;border:1px solid #dee2e6;border-radius:8px;font-size:13px;font-family:inherit;outline:none;" />
                <div id="autocomplete-list" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid #dee2e6;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.13);z-index:900;max-height:280px;overflow-y:auto;"></div>
            </div>
            <span id="sel-count-badge" style="font-size:12px;color:#2d6a4f;font-weight:700;white-space:nowrap;display:none;">
                <i class="fas fa-check-circle me-1"></i><span id="sel-count-num">0</span> selected
            </span>
        </div>
        <div id="selected-area">
            <div id="empty-state" style="display:flex;flex-direction:column;align-items:center;padding:36px 24px;gap:10px;text-align:center;">
                <div style="width:60px;height:60px;border-radius:50%;background:#f0fdf4;border:2px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:24px;color:#16a34a;">
                    <i class="fas fa-book-open"></i>
                </div>
                <div style="font-size:14px;font-weight:700;color:#1a1a2e;">No subjects added yet</div>
                <div style="font-size:12px;color:#888;">Use the search box above to find and add your enrolled subjects.</div>
            </div>
            <div id="selected-list" style="display:flex;flex-direction:column;gap:0;"></div>
        </div>
        <div style="padding:12px 16px;border-top:1px solid var(--border);text-align:right;">
            <form asp-action="ConfirmSubjects" asp-controller="Student" method="post" id="confirm-form" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="selectedSubjects" id="selected-hidden" />
                <input type="hidden" name="periodId" value="@(ViewData["ActivePeriodId"] ?? 0)" />
                <button type="submit" class="btn-green" onclick="return prepareSubmit()"><i class="fas fa-check me-2"></i>Confirm</button>
            </form>
        </div>
    </div>
</div>

<div class="page-card mb-4">
    <div class="page-card-hd dark" style="display:flex;align-items:center;justify-content:space-between;">
        <span><i class="fas fa-clipboard-list me-2"></i>Subjects Clearance</span>
        <button onclick="toggleAddPanel()" id="add-subj-btn" style="background:rgba(255,255,255,0.18);border:1px solid rgba(255,255,255,0.35);color:white;border-radius:7px;padding:5px 14px;font-size:12px;font-weight:700;cursor:pointer;">
            <i class="fas fa-plus me-1"></i>Add Subject
        </button>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Subject</th>
                    <th>Description</th>
                    <th>Instructor</th>
                    <th style="text-align:center;">Status</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (hasSubjects)
                {
                    foreach (var item in Model!.SubjectItems!)
                    {
                        <tr>
                            <td>@item.MisCode</td>
                            <td style="font-weight:600;">@item.SubjectCode</td>
                            <td>@item.Description</td>
                            <td>@item.InstructorName</td>
                            <td style="text-align:center;">
                                @if (item.Status == "Cleared")
                                {
                                    <span class="status-approved">Cleared</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="status-pending">Pending</span>
                                }
                                else
                                {
                                    <span class="status-none">—</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <div class="chat-btn-wrap" data-key="@item.MisCode" data-type="subject">
                                    <button class="chat-icon-btn"
                                            onclick="openChat('@item.MisCode', '@Html.Raw(item.InstructorName)', 'subject', '@item.SubjectCode')"
                                            title="Message @item.InstructorName">
                                        <i class="fas fa-comment-dots"></i>
                                    </button>
                                    <span class="unread-dot" style="display:none;"></span>
                                </div>
                                @if (item.Status == "Pending")
                                {
                                    <button class="delete-icon-btn"
                                            onclick="deleteClearance('subject', '@item.MisCode')"
                                            title="Delete clearance request">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <div class="empty-title">No selected subjects yet</div>
                                <div class="empty-desc">
                                    You haven't confirmed your subjects yet.<br />
                                    Click <strong>Add Subject</strong> above to select and confirm your enrolled subjects.
                                </div>
                                <button onclick="toggleAddPanel()" class="btn-green"
                                        style="display:inline-flex;align-items:center;gap:8px;padding:10px 28px;margin-top:4px;border:none;cursor:pointer;">
                                    <i class="fas fa-plus"></i>Add Subject
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   SECTION 3 — ORGANIZATION CLEARANCE
   ══════════════════════════════════════════════════════════════════════════ *@

<div class="page-card mb-4">
    <div class="page-card-hd dark">
        <i class="fas fa-sitemap me-2"></i>Organization Clearance
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Signatory</th>
                    <th style="text-align:center;">Status</th>
                    <th style="text-align:center;">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    bool hasOrgRows = (adviser != null) || (Model?.OrgItems != null && Model.OrgItems.Any());
                }
                @if (hasOrgRows)
                {
                    @* Class Adviser row (only if assigned to the student's course/year/section) *@
                    @if (adviser != null)
                    {
                        <tr>
                            <td style="font-weight:600;">
                                Class Adviser
                                <div style="font-size:11px;color:#888;font-weight:400;">@adviser.OrgRole</div>
                            </td>
                            <td>@adviser.PersonName</td>
                            <td style="text-align:center;">
                                @switch (adviser.Status)
                                {
                                    case "Cleared":
                                        <span class="status-approved">Cleared</span>
                                        break;
                                    case "Declined":
                                        <span class="status-declined">Declined</span>
                                        break;
                                    case "Pending":
                                        <span class="status-pending">Pending</span>
                                        break;
                                    default:
                                        <span style="color:#aaa;font-size:12px;">—</span>
                                        break;
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (string.IsNullOrEmpty(adviser.Status))
                                {
                                    <button class="request-btn" onclick="requestOrg('@Html.Raw(adviser.OrgName)')">
                                        <i class="fas fa-paper-plane"></i> Request
                                    </button>
                                }
                                <div class="chat-btn-wrap" data-key="@adviser.OrgName" data-type="org">
                                    <button class="chat-icon-btn"
                                            onclick="openChat('@adviser.OrgName', '@Html.Raw(adviser.PersonName)', 'org', 'Class Adviser')"
                                            title="Message @adviser.PersonName">
                                        <i class="fas fa-comment-dots"></i>
                                    </button>
                                    <span class="unread-dot" style="display:none;"></span>
                                </div>
                                @if (adviser.Status == "Pending")
                                {
                                    <button class="delete-icon-btn" onclick="deleteClearance('org', '@adviser.OrgName')" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }

                    @* Other org position rows *@
                    @if (Model?.OrgItems != null)
                    {
                    foreach (var item in Model.OrgItems)
                    {
                        <tr>
                            <td style="font-weight:600;">@item.OrgRole</td>
                            <td>@item.PersonName</td>
                            <td style="text-align:center;">
                                @switch (item.Status)
                                {
                                    case "Cleared":
                                        <span class="status-approved">Cleared</span>
                                        break;
                                    case "Declined":
                                        <span class="status-declined">Declined</span>
                                        break;
                                    case "Pending":
                                        <span class="status-pending">Pending</span>
                                        break;
                                    default:
                                        <span style="color:#aaa;font-size:12px;">—</span>
                                        break;
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (string.IsNullOrEmpty(item.Status))
                                {
                                    <button class="request-btn"
                                            onclick="requestOrg('@Html.Raw(item.OrgName)')">
                                        <i class="fas fa-paper-plane"></i> Request
                                    </button>
                                }
                                <div class="chat-btn-wrap" data-key="@item.OrgName" data-type="org">
                                    <button class="chat-icon-btn"
                                            onclick="openChat('@item.OrgName', '@Html.Raw(item.PersonName)', 'org', '@item.OrgRole')"
                                            title="Message @item.PersonName">
                                        <i class="fas fa-comment-dots"></i>
                                    </button>
                                    <span class="unread-dot" style="display:none;"></span>
                                </div>
                                @if (item.Status == "Pending")
                                {
                                    <button class="delete-icon-btn"
                                            onclick="deleteClearance('org', '@item.OrgName')"
                                            title="Delete clearance request">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="padding:40px;text-align:center;color:#888;">
                            <i class="fas fa-sitemap"
                               style="font-size:28px;color:#ddd;display:block;margin-bottom:10px;"></i>
                            No organization signatories assigned to your curriculum yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   CHAT MODAL
   ══════════════════════════════════════════════════════════════════════════ *@

<div id="chat-overlay" onclick="closeChat()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1040;"></div>

<div id="chat-modal" style="display:none;position:fixed;bottom:0;right:24px;width:360px;
     height:520px;background:white;border-radius:16px 16px 0 0;
     box-shadow:0 -4px 40px rgba(0,0,0,0.18);z-index:1050;
     display:none;flex-direction:column;overflow:hidden;">

    <!-- MODAL HEADER -->
    <div id="chat-header" style="background:var(--green,#1a4731);padding:14px 16px;
         display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <div id="chat-avatar" style="width:38px;height:38px;border-radius:50%;
             background:rgba(255,255,255,0.2);display:flex;align-items:center;
             justify-content:center;font-size:15px;font-weight:700;color:white;flex-shrink:0;">
        </div>
        <div style="flex:1;min-width:0;">
            <div id="chat-name" style="font-size:13px;font-weight:700;color:white;
                 white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
            <div id="chat-role" style="font-size:11px;color:rgba(255,255,255,0.65);margin-top:1px;"></div>
        </div>
        <button onclick="closeChat()" style="background:none;border:none;color:rgba(255,255,255,0.7);
                font-size:16px;cursor:pointer;padding:4px;line-height:1;">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- MESSAGES AREA -->
    <div id="chat-messages" style="flex:1;overflow-y:auto;padding:16px;
         display:flex;flex-direction:column;gap:10px;background:#f7f8fa;">
        <!-- messages injected here -->
    </div>

    <!-- INPUT AREA -->
    <div style="padding:12px 14px;border-top:1px solid #e2e8f0;background:white;
         display:flex;align-items:center;gap:8px;flex-shrink:0;">
        <input id="chat-input" type="text" placeholder="Type a message…"
               style="flex:1;border:1px solid #d1d5db;border-radius:22px;
                      padding:9px 14px;font-size:13px;outline:none;font-family:inherit;
                      background:#f7f8fa;"
               onkeydown="if(event.key==='Enter')sendChatMessage()" />
        <button onclick="sendChatMessage()"
                style="width:38px;height:38px;border-radius:50%;border:none;
                       background:var(--green,#1a4731);color:white;font-size:14px;
                       cursor:pointer;display:flex;align-items:center;justify-content:center;
                       flex-shrink:0;">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

@section Styles {
<style>
    /* ── PERIOD SELECTOR ── */
    .period-selector-wrap { position:relative;display:inline-block; }
    .period-btn {
        display:flex;align-items:center;gap:10px;
        background:linear-gradient(135deg,#1a4731,#2d6a4f);
        border:none;border-radius:10px;padding:9px 16px;
        cursor:pointer;transition:filter 0.2s;user-select:none;min-width:260px;
    }
    .period-btn:hover { filter:brightness(1.12); }
    .period-btn-icon {
        width:32px;height:32px;border-radius:8px;
        background:rgba(255,255,255,0.18);
        display:flex;align-items:center;justify-content:center;
        flex-shrink:0;color:white;font-size:14px;
    }
    .period-btn-text  { flex:1;text-align:left; }
    .period-btn-label { font-size:10px;color:rgba(255,255,255,0.6);margin-bottom:1px; }
    .period-btn-value { font-size:13px;font-weight:700;color:#fff;line-height:1.3; }
    .period-chevron   { color:rgba(255,255,255,0.7);font-size:11px;transition:transform 0.2s;flex-shrink:0; }
    .period-selector-wrap.open .period-chevron { transform:rotate(180deg); }

    /* ── DROPDOWN ── */
    .period-dd {
        display:none;position:absolute;top:calc(100% + 8px);right:0;
        min-width:290px;background:var(--card,#fff);
        border:1px solid var(--border,#e2e8f0);border-radius:12px;
        box-shadow:0 10px 36px rgba(0,0,0,0.18);z-index:999;
        padding:8px;flex-direction:column;gap:2px;
        max-height:320px;overflow-y:auto;
    }
    .period-selector-wrap.open .period-dd { display:flex; }
    .pd-section-label {
        font-size:10px;font-weight:700;text-transform:uppercase;
        letter-spacing:0.9px;color:var(--muted,#888);padding:6px 10px 4px;
    }
    .pd-opt {
        display:flex;align-items:center;justify-content:space-between;
        padding:9px 12px;border-radius:8px;font-size:13px;font-weight:600;
        color:var(--text,#1a1a2e);cursor:pointer;transition:background 0.15s;gap:8px;
    }
    .pd-opt:hover    { background:rgba(0,0,0,0.04); }
    .pd-opt.selected { background:rgba(26,71,49,0.1);color:#1a4731; }
    .pd-opt.selected .pd-check { display:block; }
    .pd-check     { display:none;font-size:11px;color:#1a4731;flex-shrink:0; }
    .pd-opt-status { font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;flex-shrink:0; }
    .pd-opt-status.active    { background:rgba(72,187,120,0.15);color:#38a169; }
    .pd-opt-status.completed { background:rgba(160,174,192,0.15);color:#718096; }
    .pd-loading,.pd-empty    { padding:20px;text-align:center;font-size:12px;color:var(--muted,#888); }
    .pd-divider { border:none;border-top:1px solid var(--border,#e2e8f0);margin:4px 0; }

    /* ── Empty state ── */
    .empty-state {
        display:flex;flex-direction:column;align-items:center;
        justify-content:center;padding:52px 24px;text-align:center;gap:12px;
    }
    .empty-icon {
        width:72px;height:72px;border-radius:50%;
        background:#f0fdf4;border:2px solid #bbf7d0;
        display:flex;align-items:center;justify-content:center;
        font-size:28px;color:#16a34a;margin-bottom:4px;
    }
    .empty-title { font-size:16px;font-weight:700;color:#1a1a2e; }
    .empty-desc  { font-size:13px;color:#888;line-height:1.7;max-width:340px; }

    /* ── Class Adviser card ── */
    .adviser-card-body {
        padding:20px 24px;display:flex;
        align-items:center;gap:24px;flex-wrap:wrap;
    }
    .adviser-label { font-size:11px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px; }
    .adviser-value    { font-weight:700;font-size:15px;color:#1a1a2e; }
    .adviser-divider  { width:1px;height:36px;background:#e0e0e0;flex-shrink:0; }
    .adviser-actions  { margin-left:auto;display:flex;align-items:center;gap:14px;flex-wrap:wrap; }
    .adviser-no-status    { color:#aaa;font-size:12px; }
    .adviser-cleared-label { color:#2e7d32;font-size:12px;font-weight:600; }
    .adviser-pending-label { color:#e6a817;font-size:12px;font-weight:600; }

    /* ── Status badges ── */
    .status-pending  { background:#fff8e1;color:#e6a817;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700; }
    .status-approved { background:#e8f5e9;color:#2e7d32;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700; }
    .status-declined { background:#fce4ec;color:#c62828;border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700; }
    .status-none     { color:#aaa;font-size:12px; }

    /* ── Chat icon button ── */
    .chat-btn-wrap { position:relative; display:inline-flex; }
    .unread-dot { position:absolute;top:-3px;right:-3px;width:10px;height:10px;background:#dc3545;border-radius:50%;border:1.5px solid white; }
    .chat-icon-btn {
        width:34px;height:34px;border-radius:50%;border:none;
        background:#e8f5e9;color:#1a4731;font-size:15px;
        cursor:pointer;display:inline-flex;align-items:center;
        justify-content:center;transition:background 0.2s,transform 0.15s;
    }
    .chat-icon-btn:hover { background:#c8e6c9;transform:scale(1.1); }

    /* ── Delete icon button ── */
    .delete-icon-btn {
        width:34px;height:34px;border-radius:50%;border:none;
        background:#fce4ec;color:#c62828;font-size:14px;
        cursor:pointer;display:inline-flex;align-items:center;
        justify-content:center;transition:background 0.2s,transform 0.15s;
    }
    .delete-icon-btn:hover { background:#f8bbd0;transform:scale(1.1); }

    /* ── Request button ── */
    .request-btn {
        border:none;border-radius:20px;padding:5px 14px;
        background:#e8f5e9;color:#1a4731;font-size:11px;font-weight:700;
        cursor:pointer;display:inline-flex;align-items:center;gap:5px;
        transition:background 0.2s;font-family:inherit;
    }
    .request-btn:hover { background:#c8e6c9; }

    /* ── Chat bubbles ── */
    .chat-bubble-wrap {
        display:flex;flex-direction:column;max-width:78%;
    }
    .chat-bubble-wrap.mine  { align-self:flex-end;align-items:flex-end; }
    .chat-bubble-wrap.theirs { align-self:flex-start;align-items:flex-start; }
    .chat-bubble {
        padding:9px 13px;border-radius:18px;font-size:13px;line-height:1.5;
        word-break:break-word;
    }
    .chat-bubble.mine   { background:#1a4731;color:white;border-bottom-right-radius:4px; }
    .chat-bubble.theirs { background:white;color:#1a1a2e;border:1px solid #e2e8f0;border-bottom-left-radius:4px; }
    .chat-time {
        font-size:10px;color:#aaa;margin-top:3px;padding:0 4px;
    }
    .chat-sender-name {
        font-size:10px;font-weight:700;color:#1a4731;margin-bottom:3px;padding:0 4px;
    }

    /* ── Chat date divider ── */
    .chat-date-divider {
        text-align:center;font-size:10px;color:#aaa;
        margin:6px 0;position:relative;
    }
    .chat-date-divider::before,.chat-date-divider::after {
        content:'';position:absolute;top:50%;
        width:30%;height:1px;background:#e2e8f0;
    }
    .chat-date-divider::before { left:0; }
    .chat-date-divider::after  { right:0; }
</style>
}

@section Scripts {
<script>
/* ── ADD SUBJECT DATA ── */
const ALL_SUBJECTS = [
@foreach (var s in availableSubjects)
{
    <text>{ mis:@Html.Raw(Json.Serialize(s.MisCode)), subj:@Html.Raw(Json.Serialize(s.SubjectCode)), desc:@Html.Raw(Json.Serialize(s.Description)), inst:@Html.Raw(Json.Serialize(s.InstructorName)), enrolled:@Html.Raw(s.AlreadyEnrolled?"true":"false"), status:@Html.Raw(Json.Serialize(s.EnrolledStatus)) },</text>
}
];
const ALREADY_ENROLLED = new Set(ALL_SUBJECTS.filter(s=>s.enrolled).map(s=>s.mis));
let selectedMisCodes = [];

function toggleAddPanel() {
    const p = document.getElementById('add-subject-panel');
    p.style.display = p.style.display === 'none' ? 'block' : 'none';
}
function closeAddPanel() { document.getElementById('add-subject-panel').style.display = 'none'; }

function onSearchInput(val) {
    const list = document.getElementById('autocomplete-list');
    const q = val.trim().toLowerCase();
    if (!q) { list.style.display = 'none'; return; }
    const matches = ALL_SUBJECTS.filter(s =>
        s.mis.toLowerCase().includes(q) || s.subj.toLowerCase().includes(q) ||
        s.desc.toLowerCase().includes(q) || s.inst.toLowerCase().includes(q)
    ).slice(0, 20);
    if (!matches.length) { list.innerHTML = '<div style="padding:16px;text-align:center;font-size:12px;color:#aaa;">No results found.</div>'; list.style.display='block'; return; }
    list.innerHTML = matches.map(s => {
        const already = ALREADY_ENROLLED.has(s.mis);
        const picked  = selectedMisCodes.includes(s.mis);
        const disabled = already || picked;
        const badge = already ? `<span style="font-size:10px;font-weight:700;color:#38a169;background:rgba(72,187,120,.15);padding:2px 8px;border-radius:20px;flex-shrink:0;">Added</span>`
                    : picked  ? `<span style="font-size:10px;font-weight:700;color:#3182ce;background:rgba(66,153,225,.15);padding:2px 8px;border-radius:20px;flex-shrink:0;">Selected</span>` : '';
        return `<div data-mis="${escHtml(s.mis)}" data-disabled="${disabled}"
                     style="display:flex;align-items:center;gap:12px;padding:10px 14px;
                            cursor:${disabled?'not-allowed':'pointer'};border-bottom:1px solid #f0f0f0;
                            transition:background .12s;opacity:${disabled?'0.6':'1'};"
                     onmouseover="if(!this.dataset.disabled||this.dataset.disabled==='false')this.style.background='#f0fdf4'"
                     onmouseout="this.style.background=''">
            <span style="font-size:11px;font-weight:700;background:#e8f5e9;color:#2d6a4f;padding:3px 8px;border-radius:6px;white-space:nowrap;flex-shrink:0;">${escHtml(s.mis)}</span>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:600;color:#1a1a2e;">${escHtml(s.subj)}</div>
                <div style="font-size:11px;color:#888;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(s.desc)}</div>
            </div>
            <span style="font-size:11px;color:#aaa;white-space:nowrap;flex-shrink:0;">${escHtml(s.inst)}</span>
            ${badge}
        </div>`;
    }).join('');
    list.style.display = 'block';
    // Use event delegation — safe, no inline onclick escaping issues
    list.querySelectorAll('[data-mis]').forEach(el => {
        if (el.dataset.disabled === 'true') return;
        el.addEventListener('click', () => addSubject(el.dataset.mis));
    });
}
function addSubject(mis) {
    if (ALREADY_ENROLLED.has(mis) || selectedMisCodes.includes(mis)) return;
    selectedMisCodes.push(mis);
    document.getElementById('subject-search').value = '';
    document.getElementById('autocomplete-list').style.display = 'none';
    renderSelected();
}
function removeSelected(mis) {
    selectedMisCodes = selectedMisCodes.filter(m => m !== mis);
    renderSelected();
}
function renderSelected() {
    const list  = document.getElementById('selected-list');
    const empty = document.getElementById('empty-state');
    const badge = document.getElementById('sel-count-badge');
    const num   = document.getElementById('sel-count-num');
    if (!selectedMisCodes.length) { list.innerHTML=''; empty.style.display='flex'; badge.style.display='none'; return; }
    empty.style.display = 'none';
    badge.style.display = '';
    num.textContent = selectedMisCodes.length;
    list.innerHTML = selectedMisCodes.map(mis => {
        const s = ALL_SUBJECTS.find(x => x.mis === mis);
        if (!s) return '';
        return `<div style="display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid var(--border,#e2e8f0);">
            <span style="font-size:11px;font-weight:700;background:#e8f5e9;color:#2d6a4f;padding:3px 8px;border-radius:6px;white-space:nowrap;">${escHtml(s.mis)}</span>
            <span style="font-size:13px;font-weight:600;color:#1a1a2e;flex:1;">${escHtml(s.subj)}</span>
            <span style="font-size:12px;color:#666;flex:2;">${escHtml(s.desc)}</span>
            <span style="font-size:12px;color:#aaa;flex-shrink:0;">${escHtml(s.inst)}</span>
            <button onclick="removeSelected('${mis}')" style="background:none;border:none;cursor:pointer;color:#ccc;font-size:17px;padding:0 2px;transition:color .15s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#ccc'">
                <i class="fas fa-times"></i>
            </button>
        </div>`;
    }).join('');
}
function prepareSubmit() {
    if (!selectedMisCodes.length) { alert('No subjects selected.'); return false; }
    document.getElementById('selected-hidden').value = selectedMisCodes.join(',');
    return true;
}
document.addEventListener('click', e => {
    const list = document.getElementById('autocomplete-list');
    const inp  = document.getElementById('subject-search');
    if (list && inp && !inp.contains(e.target) && !list.contains(e.target))
        list.style.display = 'none';
});
function escHtml(s) { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

/* ── CLEARANCE PAGE ── */
    const _csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    /* ══════════════════════════════════════════
       PERIOD DROPDOWN
    ══════════════════════════════════════════ */
    const _serverPeriodId = @(ViewData["ActivePeriodId"] is int svPid ? svPid : 0);
    let allPeriods = [], selectedPeriodId = _serverPeriodId;

    async function loadPeriods() {
        const dd = document.getElementById('period-dd');
        try {
            const res  = await fetch('/api/student/periods');
            allPeriods = await res.json();
        } catch { allPeriods = []; }

        dd.innerHTML = '';
        if (!allPeriods.length) {
            dd.innerHTML = '<div class="pd-empty"><i class="fas fa-calendar-times me-2"></i>No academic periods found.</div>';
            return;
        }

        const preselected = allPeriods.find(p => p.id === _serverPeriodId) ?? allPeriods[0];
        selectedPeriodId = preselected.id;
        updatePeriodDisplay(preselected);

        allPeriods.forEach(p => {
            const opt     = document.createElement('div');
            opt.className = 'pd-opt' + (p.id === selectedPeriodId ? ' selected' : '');
            opt.dataset.id = p.id;
            opt.innerHTML = `
                <span style="flex:1;">${escHtml(p.sem)}, A.Y. ${escHtml(p.ay)}</span>
                <i class="fas fa-check pd-check"></i>`;
            opt.onclick = (e) => { e.stopPropagation(); selectPeriod(p); };
            dd.appendChild(opt);
        });
    }

    function selectPeriod(p) {
        // Reload page for the selected period so clearance data comes from DB
        window.location.href = '/Student/Clearance?periodId=' + p.id;
    }

    function updatePeriodDisplay(p) {
        document.getElementById('period-btn-value').textContent = `${p.sem}, A.Y. ${p.ay}`;
    }

    function togglePeriodDd(e) { e.stopPropagation(); document.getElementById('period-wrap').classList.toggle('open'); }
    function closePeriodDd()    { document.getElementById('period-wrap').classList.remove('open'); }

    document.addEventListener('click', function(e) {
        const wrap = document.getElementById('period-wrap');
        if (wrap && !wrap.contains(e.target)) closePeriodDd();
    });

    /* ══════════════════════════════════════════
       UNREAD NOTIFICATION BADGES
    ══════════════════════════════════════════ */
    async function loadUnreadBadges() {
        try {
            const unreads = await (await fetch('/Student/GetUnreadCounts')).json();
            // Reset all dots first
            document.querySelectorAll('.chat-btn-wrap .unread-dot').forEach(d => d.style.display = 'none');
            // Show dots for unread messages
            unreads.forEach(u => {
                document.querySelectorAll('.chat-btn-wrap').forEach(w => {
                    if (w.dataset.key === u.clearanceKey && w.dataset.type === u.clearanceType) {
                        const dot = w.querySelector('.unread-dot');
                        if (dot) dot.style.display = 'block';
                    }
                });
            });
        } catch {}
    }
    async function markRead(key, type) {
        try {
            await fetch('/Student/MarkMessagesRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
                body: JSON.stringify({ clearanceKey: key, clearanceType: type, message: '' })
            });
        } catch {}
    }
    function clearUnreadDot(key, type) {
        document.querySelectorAll('.chat-btn-wrap').forEach(w => {
            if (w.dataset.key === key && w.dataset.type === type) {
                const dot = w.querySelector('.unread-dot');
                if (dot) dot.style.display = 'none';
            }
        });
    }

    /* ══════════════════════════════════════════
       REQUEST ORG CLEARANCE
    ══════════════════════════════════════════ */
    function requestOrg(position) {
        fetch('/Student/RequestOrgSignature', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body:    JSON.stringify({ orgName: position, periodId: _serverPeriodId })
        })
        .then(r => r.json())
        .then(d => { if (d.success) location.reload(); else alert(d.error ?? 'Request failed'); })
        .catch(err => console.warn('Request error:', err));
    }

    /* ══════════════════════════════════════════
       DELETE CLEARANCE
    ══════════════════════════════════════════ */
    function deleteClearance(type, key) {
        if (!confirm('Remove this pending clearance request?')) return;
        fetch('/Student/DeleteClearanceRequest', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body:    JSON.stringify({ type, key, periodId: _serverPeriodId })
        })
        .then(r => r.json())
        .then(d => { if (d.success) location.reload(); else alert(d.error ?? 'Delete failed'); })
        .catch(err => console.warn('Delete error:', err));
    }

    /* ══════════════════════════════════════════
       CHAT  — backed by clearance_messages table
    ══════════════════════════════════════════ */
    let currentChatKey  = null;
    let currentChatType = null;
    let currentChatName = null;

    function getInitials(name) {
        return (name ?? '').split(' ').filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase();
    }

    function fmtTime(d) {
        return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    }

    async function openChat(key, personName, type, role) {
        currentChatKey  = key;
        currentChatType = type;
        currentChatName = personName;

        document.getElementById('chat-name').textContent    = personName;
        document.getElementById('chat-role').textContent    = role;
        document.getElementById('chat-avatar').textContent  = getInitials(personName);

        const modal   = document.getElementById('chat-modal');
        const overlay = document.getElementById('chat-overlay');
        modal.style.display   = 'flex';
        overlay.style.display = 'block';

        // Show loading state then fetch from server
        document.getElementById('chat-messages').innerHTML =
            '<div style="text-align:center;margin:auto;font-size:12px;color:#aaa;">' +
            '<i class="fas fa-spinner fa-spin me-1"></i>Loading messages...</div>';

        await markRead(key, type);
        clearUnreadDot(key, type);
        fetchMessages();
        setTimeout(() => document.getElementById('chat-input').focus(), 80);
    }

    function closeChat() {
        document.getElementById('chat-modal').style.display   = 'none';
        document.getElementById('chat-overlay').style.display = 'none';
        currentChatKey  = null;
        currentChatType = null;
    }

    async function fetchMessages() {
        if (!currentChatKey) return;
        try {
            const res  = await fetch(
                `/Student/GetClearanceMessages?key=${encodeURIComponent(currentChatKey)}&type=${encodeURIComponent(currentChatType)}`
            );
            const data = await res.json();
            if (data.success) renderMessages(data.messages ?? []);
        } catch (err) {
            console.warn('Failed to load messages:', err);
        }
    }

    function renderMessages(msgs) {
        const box = document.getElementById('chat-messages');
        box.innerHTML = '';

        if (!msgs.length) {
            box.innerHTML = `
                <div style="text-align:center;margin:auto;">
                    <div style="font-size:32px;margin-bottom:10px;">💬</div>
                    <div style="font-size:13px;font-weight:700;color:#1a1a2e;margin-bottom:4px;">
                        Start the conversation
                    </div>
                    <div style="font-size:12px;color:#aaa;max-width:220px;margin:0 auto;line-height:1.6;">
                        Send a message to <strong>${escHtml(currentChatName)}</strong> about your clearance.
                    </div>
                </div>`;
            return;
        }

        let lastDate = null;
        msgs.forEach(m => {
            const d       = new Date(m.time);
            const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

            if (dateStr !== lastDate) {
                const div       = document.createElement('div');
                div.className   = 'chat-date-divider';
                div.textContent = dateStr;
                box.appendChild(div);
                lastDate = dateStr;
            }

            const wrap     = document.createElement('div');
            wrap.className = 'chat-bubble-wrap ' + (m.mine ? 'mine' : 'theirs');

            if (!m.mine) {
                const sn       = document.createElement('div');
                sn.className   = 'chat-sender-name';
                sn.textContent = currentChatName;
                wrap.appendChild(sn);
            }

            const bubble       = document.createElement('div');
            bubble.className   = 'chat-bubble ' + (m.mine ? 'mine' : 'theirs');
            bubble.textContent = m.text;
            wrap.appendChild(bubble);

            const time       = document.createElement('div');
            time.className   = 'chat-time';
            time.textContent = fmtTime(d);
            wrap.appendChild(time);

            box.appendChild(wrap);
        });

        box.scrollTop = box.scrollHeight;
    }

    async function sendChatMessage() {
        const input = document.getElementById('chat-input');
        const text  = input.value.trim();
        if (!text || !currentChatKey) return;

        // Optimistically append the message in the UI
        const tempMsg = { mine: true, text, time: new Date().toISOString() };
        const existingMsgs = Array.from(document.querySelectorAll('#chat-messages .chat-bubble-wrap'))
            .length > 0;

        input.value = '';
        if (!existingMsgs) {
            // Was showing empty state; re-render with just this message
            renderMessages([tempMsg]);
        } else {
            // Append bubble directly
            appendBubble(tempMsg);
            document.getElementById('chat-messages').scrollTop = 999999;
        }

        try {
            const res  = await fetch('/Student/SendClearanceMessage', {
                method:  'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': _csrf
                },
                body: JSON.stringify({
                    clearanceType: currentChatType,
                    clearanceKey:  currentChatKey,
                    message:       text
                })
            });
            const data = await res.json();
            if (!data.success) console.warn('Message send failed:', data.error);
        } catch (err) {
            console.warn('Chat error:', err);
        }
    }

    function appendBubble(m) {
        const box  = document.getElementById('chat-messages');
        const wrap = document.createElement('div');
        wrap.className = 'chat-bubble-wrap ' + (m.mine ? 'mine' : 'theirs');

        const bubble       = document.createElement('div');
        bubble.className   = 'chat-bubble ' + (m.mine ? 'mine' : 'theirs');
        bubble.textContent = m.text;
        wrap.appendChild(bubble);

        const time       = document.createElement('div');
        time.className   = 'chat-time';
        time.textContent = fmtTime(new Date(m.time));
        wrap.appendChild(time);

        box.appendChild(wrap);
    }

    function escHtml(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeChat(); });

    loadPeriods();
    loadUnreadBadges();
    setInterval(loadUnreadBadges, 30000);
</script>
}