        content:'';position:absolute;top:50%;width:30%;height:1px;background:#e2e8f0;
    }
    .chat-date-divider::before { left:0; }
    .chat-date-divider::after  { right:0; }

    /* ── Approve / Decline buttons ── */
    .btn-approve { background:#2e7d32;color:#fff;border:none;border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity .2s;white-space:nowrap; }
    .btn-approve:hover { opacity:.85; }
    .btn-decline { background:#c62828;color:#fff;border:none;border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity .2s;white-space:nowrap; }
    .btn-decline:hover { opacity:.85; }
</style>
}

@section Scripts {
<script>
/* ── ADD SUBJECT DATA ── */
const ALL_SUBJECTS = [
@foreach (var s in availableSubjects)
{
    <text>{ mis:@Html.Raw(Json.Serialize(s.MisCode)), subj:@Html.Raw(Json.Serialize(s.SubjectCode)), desc:@Html.Raw(Json.Serialize(s.Description)), inst:@Html.Raw(Json.Serialize(s.InstructorName)), enrolled:@Html.Raw(s.AlreadyEnrolled?"true":"false"), status:@Html.Raw(Json.Serialize(s.EnrolledStatus)) },</text>
}
];
const ALREADY_ENROLLED = new Set(ALL_SUBJECTS.filter(s=>s.enrolled).map(s=>s.mis));
let selectedMisCodes = [];

function toggleAddPanel() {
    const p = document.getElementById('add-subject-panel');
    p.style.display = p.style.display === 'none' ? 'block' : 'none';
}
function closeAddPanel() { document.getElementById('add-subject-panel').style.display = 'none'; }

function onSearchInput(val) {
    const list = document.getElementById('autocomplete-list');
    const q = val.trim().toLowerCase();
    if (!q) { list.style.display = 'none'; return; }
    const matches = ALL_SUBJECTS.filter(s =>
        s.mis.toLowerCase().includes(q) || s.subj.toLowerCase().includes(q) ||
        s.desc.toLowerCase().includes(q) || s.inst.toLowerCase().includes(q)
    ).slice(0, 20);
    if (!matches.length) { list.innerHTML = '<div style="padding:16px;text-align:center;font-size:12px;color:#aaa;">No results found.</div>'; list.style.display='block'; return; }
    list.innerHTML = matches.map(s => {
        const already = ALREADY_ENROLLED.has(s.mis);
        const picked  = selectedMisCodes.includes(s.mis);
        const disabled = already || picked;
        const badge = already ? `<span style="font-size:10px;font-weight:700;color:#38a169;background:rgba(72,187,120,.15);padding:2px 8px;border-radius:20px;flex-shrink:0;">Added</span>`
                    : picked  ? `<span style="font-size:10px;font-weight:700;color:#3182ce;background:rgba(66,153,225,.15);padding:2px 8px;border-radius:20px;flex-shrink:0;">Selected</span>` : '';
        return `<div data-mis="${escHtml(s.mis)}" data-disabled="${disabled}"
                     style="display:flex;align-items:center;gap:12px;padding:10px 14px;
                            cursor:${disabled?'not-allowed':'pointer'};border-bottom:1px solid #f0f0f0;
                            transition:background .12s;opacity:${disabled?'0.6':'1'};"
                     onmouseover="if(!this.dataset.disabled||this.dataset.disabled==='false')this.style.background='#f0fdf4'"
                     onmouseout="this.style.background=''">
            <span style="font-size:11px;font-weight:700;background:#e8f5e9;color:#2d6a4f;padding:3px 8px;border-radius:6px;white-space:nowrap;flex-shrink:0;">${escHtml(s.mis)}</span>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:600;color:#1a1a2e;">${escHtml(s.subj)}</div>
                <div style="font-size:11px;color:#888;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(s.desc)}</div>
            </div>
            <span style="font-size:11px;color:#aaa;white-space:nowrap;flex-shrink:0;">${escHtml(s.inst)}</span>
            ${badge}
        </div>`;
    }).join('');
    list.style.display = 'block';
    list.querySelectorAll('[data-mis]').forEach(el => {
        if (el.dataset.disabled === 'true') return;
        el.addEventListener('click', () => addSubject(el.dataset.mis));
    });
}
function addSubject(mis) {
    if (ALREADY_ENROLLED.has(mis) || selectedMisCodes.includes(mis)) return;
    selectedMisCodes.push(mis);
    document.getElementById('subject-search').value = '';
    document.getElementById('autocomplete-list').style.display = 'none';
    renderSelected();
}
function removeSelected(mis) {
    selectedMisCodes = selectedMisCodes.filter(m => m !== mis);
    renderSelected();
}
function renderSelected() {
    const list  = document.getElementById('selected-list');
    const empty = document.getElementById('empty-state');
    const badge = document.getElementById('sel-count-badge');
    const num   = document.getElementById('sel-count-num');
    if (!selectedMisCodes.length) { list.innerHTML=''; empty.style.display='flex'; badge.style.display='none'; return; }
    empty.style.display = 'none';
    badge.style.display = '';
    num.textContent = selectedMisCodes.length;
    list.innerHTML = selectedMisCodes.map(mis => {
        const s = ALL_SUBJECTS.find(x => x.mis === mis);
        if (!s) return '';
        return `<div style="display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid var(--border,#e2e8f0);">
            <span style="font-size:11px;font-weight:700;background:#e8f5e9;color:#2d6a4f;padding:3px 8px;border-radius:6px;white-space:nowrap;">${escHtml(s.mis)}</span>
            <span style="font-size:13px;font-weight:600;color:#1a1a2e;flex:1;">${escHtml(s.subj)}</span>
            <span style="font-size:12px;color:#666;flex:2;">${escHtml(s.desc)}</span>
            <span style="font-size:12px;color:#aaa;flex-shrink:0;">${escHtml(s.inst)}</span>
            <button onclick="removeSelected('${mis}')" style="background:none;border:none;cursor:pointer;color:#ccc;font-size:17px;padding:0 2px;transition:color .15s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#ccc'">
                <i class="fas fa-times"></i>
            </button>
        </div>`;
    }).join('');
}
function prepareSubmit() {
    if (!selectedMisCodes.length) { alert('No subjects selected.'); return false; }
    document.getElementById('selected-hidden').value = selectedMisCodes.join(',');
    return true;
}
document.addEventListener('click', e => {
    const list = document.getElementById('autocomplete-list');
    const inp  = document.getElementById('subject-search');
    if (list && inp && !inp.contains(e.target) && !list.contains(e.target))
        list.style.display = 'none';
});
function escHtml(s) { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

/* ── CLEARANCE PAGE ── */
const _csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

/* ══════════════════════════════════════════
   PERIOD DROPDOWN
══════════════════════════════════════════ */
const _serverPeriodId = @(ViewData["ActivePeriodId"] is int svPid ? svPid : 0);
const allPeriods = @Html.Raw(periodsJson);

function buildPeriodDropdown() {
    const dd = document.getElementById('period-dd');
    dd.innerHTML = '';
    if (!allPeriods || !allPeriods.length) {
        dd.innerHTML = '<div class="pd-empty"><i class="fas fa-calendar-times me-2"></i>No academic periods found.</div>';
        return;
    }
    const active = allPeriods.find(p => p.id === _serverPeriodId) ?? allPeriods[0];
    document.getElementById('period-btn-value').textContent = `${active.sem}, A.Y. ${active.ay}`;
    allPeriods.forEach(p => {
        const opt     = document.createElement('div');
        opt.className = 'pd-opt' + (p.id === _serverPeriodId ? ' selected' : '');
        opt.innerHTML = `<span style="flex:1;">${escHtml(p.sem)}, A.Y. ${escHtml(p.ay)}</span>
                         <i class="fas fa-check pd-check"></i>`;
        opt.onclick = (e) => { e.stopPropagation(); selectPeriod(p); };
        dd.appendChild(opt);
    });
}
function selectPeriod(p) {
    window.location.href = '/Student/Clearance?periodId=' + p.id;
}
function togglePeriodDd(e) {
    e.stopPropagation();
    document.getElementById('period-wrap').classList.toggle('open');
}
document.addEventListener('click', function(e) {
    const wrap = document.getElementById('period-wrap');
    if (wrap && !wrap.contains(e.target)) wrap.classList.remove('open');
});

/* ══════════════════════════════════════════
   INNER TAB SWITCHING (Subjects / Departmental)
══════════════════════════════════════════ */
function switchInnerTab(tab) {
    const ps = document.getElementById('inner-panel-subjects');
    const pd = document.getElementById('inner-panel-departmental');
    if (ps) ps.style.display = tab === 'subjects'     ? 'block' : 'none';
    if (pd) pd.style.display = tab === 'departmental' ? 'block' : 'none';
    // update opacity on all card-switcher spans
    ['csw-subjects','csw-subjects2'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.opacity = tab === 'subjects' ? '1' : '0.55';
    });
    ['csw-departmental','csw-departmental2'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.opacity = tab === 'departmental' ? '1' : '0.55';
    });
    if (window.location.hash !== '#approval') {
        history.replaceState(null, '', tab === 'departmental'
            ? window.location.pathname + window.location.search + '#departmental'
            : window.location.pathname + window.location.search);
    }
}
// Restore inner tab from hash on load
if (window.location.hash === '#departmental') switchInnerTab('departmental');

/* ══════════════════════════════════════════
   OUTER TAB SWITCHING (My Clearance / Approval)
══════════════════════════════════════════ */
function switchTab(tab) {
    const pc = document.getElementById('panel-clearance');
    const pa = document.getElementById('panel-approval');
    if (pc) pc.style.display = tab === 'clearance' ? 'block' : 'none';
    if (pa) pa.style.display = tab === 'approval'  ? 'block' : 'none';
    document.querySelectorAll('.ctab').forEach(t => t.classList.remove('active'));
    const btn = document.getElementById('tab-' + tab);
    if (btn) btn.classList.add('active');
    if (tab === 'approval') history.replaceState(null, '', '#approval');
    else history.replaceState(null, '', window.location.pathname + window.location.search);
}
if (window.location.hash === '#approval' && document.getElementById('panel-approval')) switchTab('approval');

/* ══════════════════════════════════════════
   UNREAD NOTIFICATION BADGES
   FIX: normalized (trim + lowercase) comparison on sn/key/type,
   matching the approach already used on the Instructor and Staff
   pages, and toggled via the .has-unread CSS class instead of
   inline style so it can't be left half-applied. Rows that have
   no data-sn (the student's own clearance items) match on
   key+type alone; rows that DO have data-sn (approval-request
   rows, where multiple students can share the same position key)
   must also match the student number, otherwise one student's
   unread message could light up another student's row.
══════════════════════════════════════════ */
async function loadUnreadBadges() {
    try {
        const res = await fetch('/Student/GetUnreadCounts');
        if (!res.ok) return;
        const unreads = await res.json();

        document.querySelectorAll('.unread-dot').forEach(d => d.classList.remove('has-unread'));

        if (!unreads || !unreads.length) return;

        unreads.forEach(u => {
            const uSn   = String(u.studentNumber ?? '').trim().toLowerCase();
            const uKey  = String(u.clearanceKey  ?? '').trim().toLowerCase();
            const uType = String(u.clearanceType ?? '').trim().toLowerCase();

            document.querySelectorAll('.chat-btn-wrap').forEach(wrap => {
                const wSn   = String(wrap.dataset.sn   ?? '').trim().toLowerCase();
                const wKey  = String(wrap.dataset.key  ?? '').trim().toLowerCase();
                const wType = String(wrap.dataset.type ?? '').trim().toLowerCase();

                const snOk = wSn === '' ? true : wSn === uSn;

                if (snOk && wKey === uKey && wType === uType) {
                    const dot = wrap.querySelector('.unread-dot');
                    if (dot) dot.classList.add('has-unread');
                }
            });
        });
    } catch (e) {
        console.error('[unread-badges] error:', e);
    }
}
async function markRead(key, type) {
    try {
        await fetch('/Student/MarkMessagesRead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body: JSON.stringify({ clearanceKey: key, clearanceType: type, message: '' })
        });
    } catch {}
}
function clearUnreadDot(key, type, sn) {
    const keyL  = String(key  ?? '').trim().toLowerCase();
    const typeL = String(type ?? '').trim().toLowerCase();
    const snL   = String(sn   ?? '').trim().toLowerCase();
    document.querySelectorAll('.chat-btn-wrap').forEach(w => {
        const wSn   = String(w.dataset.sn   ?? '').trim().toLowerCase();
        const wKey  = String(w.dataset.key  ?? '').trim().toLowerCase();
        const wType = String(w.dataset.type ?? '').trim().toLowerCase();
        const snOk  = wSn === '' ? true : wSn === snL;
        if (snOk && wKey === keyL && wType === typeL) {
            const dot = w.querySelector('.unread-dot');
            if (dot) dot.classList.remove('has-unread');
        }
    });
}

