@model OnlineClearanceSystem.Models.StudentClearanceViewModel
@using OnlineClearanceSystem.Models
@{
    ViewData["Title"]      = "Clearance";
    ViewData["ActivePage"] = "Clearance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    bool hasSubjects = Model?.SubjectItems != null && Model.SubjectItems.Any();
    var availableSubjects = ViewBag.AvailableSubjects as IEnumerable<SubjectItem> ?? Enumerable.Empty<SubjectItem>();
    var adviser     = Model?.ClassAdviser;

    var periodsJson = ViewBag.Periods as string ?? "[]";

    var posRank = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
    {
        { "Computer Laboratory In-Charge", 1 },
        { "SSG Treasurer",                 2 },
        { "Organization Adviser",          3 },
        { "Class Adviser",                 4 },
        { "Department Chairperson",        5 },
    };
    const int defaultRank = 99;

    var allSignatories = new List<OrganizationSignatory>(Model?.OrgItems ?? new List<OrganizationSignatory>());

    if (adviser != null &&
        !allSignatories.Any(x => x.OrgName.Equals("Class Adviser", StringComparison.OrdinalIgnoreCase)))
    {
        allSignatories.Add(adviser);
    }

    allSignatories = allSignatories
        .OrderBy(x => posRank.TryGetValue(x.OrgName, out var r) ? r : defaultRank)
        .ThenBy(x => x.OrgName, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

@Html.AntiForgeryToken()

@* ── Alerts ── *@
@if (TempData["OrgSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["OrgSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["OrgError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["OrgError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- HEADER ROW -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">

    @if (Model?.MyPositions != null && Model.MyPositions.Any())
    {
        <div style="display:inline-flex;align-items:center;gap:0;border-radius:10px;overflow:hidden;border:1px solid #c8e6c9;">
            <div style="background:#1a4731;padding:8px 14px;font-size:12px;font-weight:700;color:white;white-space:nowrap;">
                <i class="fas fa-user-tag me-2"></i>Your Assigned Position(s)
            </div>
            <div style="background:white;padding:6px 12px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
                @foreach (var pos in Model.MyPositions)
                {
                    <span style="background:#e8f5e9;color:#1a4731;border:1.5px solid #a5d6a7;border-radius:20px;
                                 padding:4px 14px;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;">
                        <i class="fas fa-check-circle" style="color:#28a745;"></i>@pos
                    </span>
                }
            </div>
        </div>
    }

    <!-- PERIOD SELECTOR DROPDOWN -->
    <div class="period-selector-wrap" id="period-wrap">
        <button class="period-btn" id="period-btn" onclick="togglePeriodDd(event)" type="button">
            <div class="period-btn-icon"><i class="fas fa-calendar-alt"></i></div>
            <div class="period-btn-text">
                <div class="period-btn-label">Academic Period</div>
                <div class="period-btn-value" id="period-btn-value">
                    @(ViewData["ActivePeriod"]?.ToString() ?? "Select Period")
                </div>
            </div>
            <i class="fas fa-chevron-down period-chevron"></i>
        </button>

        <div class="period-dd" id="period-dd">
            <!-- Populated by buildPeriodDropdown() -->
        </div>
    </div>
</div>

@{ bool hasApproval = Model?.MyPositions != null && Model.MyPositions.Any(); }

<!-- ══ TOP-LEVEL TAB BAR (My Clearance / Approval Requests) ══ -->
@if (hasApproval)
{
<div class="clearance-tab-bar mb-3">
    <button class="ctab ctab-clearance active" id="tab-clearance" onclick="switchTab('clearance')">
        <i class="fas fa-clipboard-list"></i>My Clearance
    </button>
    <button class="ctab ctab-approval" id="tab-approval" onclick="switchTab('approval')">
        <i class="fas fa-file-signature"></i>Approval Requests
        @if (Model!.PendingToApprove.Any())
        {
            <span class="ctab-badge">@Model.PendingToApprove.Count</span>
        }
    </button>
</div>
}

<!-- ══ CLEARANCE PANEL ══ -->
<div id="panel-clearance">

    @* ══════════════════════════════════════════════════════════════════════════
       SECTION 1 — SUBJECT CLEARANCE
       ══════════════════════════════════════════════════════════════════════════ *@

    <div id="inner-panel-subjects">
    <div class="page-card mb-4">
        <div class="page-card-hd dark" style="display:flex;align-items:center;justify-content:space-between;cursor:default;">
            <div style="display:flex;gap:0;">
                <span class="card-switcher active" id="csw-subjects" onclick="switchInnerTab('subjects')"
                      style="display:inline-flex;align-items:center;gap:6px;padding:0 18px 0 0;cursor:pointer;">
                    <i class="fas fa-clipboard-list"></i>Subjects Clearance
                </span>
                <span style="color:rgba(255,255,255,0.3);margin:0 4px;">|</span>
                <span class="card-switcher" id="csw-departmental" onclick="switchInnerTab('departmental')"
                      style="display:inline-flex;align-items:center;gap:6px;padding:0 0 0 18px;cursor:pointer;opacity:0.55;">
                    <i class="fas fa-sitemap"></i>Departmental Clearance
                </span>
            </div>
            <button onclick="toggleAddPanel()" id="add-subj-btn" style="background:rgba(255,255,255,0.18);border:1px solid rgba(255,255,255,0.35);color:white;border-radius:7px;padding:5px 14px;font-size:12px;font-weight:700;cursor:pointer;">
                <i class="fas fa-plus me-1"></i>Add Subject
            </button>
        </div>

        <!-- INLINE ADD SUBJECT -->
        <div id="add-subject-panel" style="display:none;border-bottom:1px solid var(--border,#e2e8f0);background:#fafbfc;">
            <div style="padding:12px 16px;border-bottom:1px solid var(--border,#e2e8f0);display:flex;align-items:center;gap:10px;">
                <div class="search-wrap" style="position:relative;flex:1;max-width:500px;">
                    <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#aaa;font-size:13px;"></i>
                    <input type="text" id="subject-search"
                           placeholder="Search by MIS code, subject or instructor…"
                           autocomplete="off" oninput="onSearchInput(this.value)"
                           style="width:100%;padding:9px 12px 9px 36px;border:1px solid #dee2e6;border-radius:8px;font-size:13px;font-family:inherit;outline:none;" />
                    <div id="autocomplete-list" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid #dee2e6;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.13);z-index:900;max-height:280px;overflow-y:auto;"></div>
                </div>
                <span id="sel-count-badge" style="font-size:12px;color:#2d6a4f;font-weight:700;white-space:nowrap;display:none;">
                    <i class="fas fa-check-circle me-1"></i><span id="sel-count-num">0</span> selected
                </span>
                <button onclick="closeAddPanel()" style="background:#eef0f3;border:1px solid #dee2e6;color:#555;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer;">
                    <i class="fas fa-times me-1"></i>Close
                </button>
            </div>
            <div id="selected-area">
                <div id="empty-state" style="display:flex;flex-direction:column;align-items:center;padding:28px 24px;gap:8px;text-align:center;">
                    <div style="width:52px;height:52px;border-radius:50%;background:#f0fdf4;border:2px solid #bbf7d0;display:flex;align-items:center;justify-content:center;font-size:22px;color:#16a34a;">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <div style="font-size:13px;font-weight:700;color:#1a1a2e;">No subjects selected yet</div>
                    <div style="font-size:12px;color:#888;">Use the search box above to find and add your enrolled subjects.</div>
                </div>
                <div id="selected-list" style="display:flex;flex-direction:column;gap:0;"></div>
            </div>
            <div style="padding:12px 16px;border-top:1px solid var(--border,#e2e8f0);text-align:right;">
                <form asp-action="ConfirmSubjects" asp-controller="Student" method="post" id="confirm-form" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="selectedSubjects" id="selected-hidden" />
                    <input type="hidden" name="periodId" value="@(ViewData["ActivePeriodId"] ?? 0)" />
                    <button type="submit" class="btn-green" onclick="return prepareSubmit()"><i class="fas fa-check me-2"></i>Confirm</button>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>MIS Code</th>
                        <th>Subject Code</th>
                        <th>Description</th>
                        <th>Instructor</th>
                        <th style="text-align:center;">Status</th>
                        <th style="text-align:center;">Requested</th>
                        <th style="text-align:center;">Cleared</th>
                        <th style="text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasSubjects)
                    {
                        foreach (var item in Model!.SubjectItems!)
                        {
                            <tr>
                                <td>@item.MisCode</td>
                                <td style="font-weight:600;">@item.SubjectCode</td>
                                <td>@item.Description</td>
                                <td>@item.InstructorName</td>
                                <td style="text-align:center;">
                                    @if (item.Status == "Cleared")
                                    {
                                        <span class="status-approved">Cleared</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="status-pending">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="status-none">—</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    @if (item.RequestedAt.HasValue)
                                    {
                                        <span class="date-stamp">
                                            <i class="fas fa-paper-plane date-icon"></i>
                                            @item.RequestedAt.Value.ToString("MMM d, yyyy")
                                            <span class="date-time">@item.RequestedAt.Value.ToString("h:mm tt")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="date-none">—</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    @if (item.SignedAt.HasValue)
                                    {
                                        <span class="date-stamp date-stamp-signed">
                                            <i class="fas fa-check-circle date-icon"></i>
                                            @item.SignedAt.Value.ToString("MMM d, yyyy")
                                            <span class="date-time">@item.SignedAt.Value.ToString("h:mm tt")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="date-none">—</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <div class="chat-btn-wrap" data-key="@item.MisCode" data-type="subject">
                                        <button class="chat-icon-btn"
                                                onclick="openChat('@item.MisCode', '@Html.Raw(item.InstructorName)', 'subject', '@item.SubjectCode')"
                                                title="@(item.Status == "Cleared" ? "Clearance already approved" : "Message " + item.InstructorName)"
                                                @(item.Status == "Cleared" ? "disabled" : "")>
                                            <i class="fas fa-comment-dots"></i>
                                        </button>
                                        <span class="unread-dot"></span>
                                    </div>
                                    <button class="delete-icon-btn"
                                            onclick="deleteClearance('subject', '@item.MisCode')"
                                            title="Delete clearance request"
                                            @(item.Status != "Pending" ? "disabled" : "")>
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                    @if (item.Status == "Declined")
                                    {
                                        <button class="request-btn"
                                                onclick="reRequestSubject('@item.MisCode')"
                                                title="Re-request clearance">
                                            <i class="fas fa-redo me-1"></i>Re-request
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="fas fa-clipboard-list"></i>
                                    </div>
                                    <div class="empty-title">No selected subjects yet</div>
                                    <div class="empty-desc">
                                        You haven't confirmed your subjects yet.<br />
                                        Click <strong>Add Subject</strong> above to select and confirm your enrolled subjects.
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>@* end #inner-panel-subjects *@

    @* ══════════════════════════════════════════════════════════════════════════
       SECTION 2 — DEPARTMENTAL CLEARANCE
       ══════════════════════════════════════════════════════════════════════════ *@

    <div id="inner-panel-departmental" style="display:none;">
    <div class="page-card mb-4">
        <div class="page-card-hd dark" style="display:flex;align-items:center;cursor:default;">
            <div style="display:flex;gap:0;">
                <span class="card-switcher" id="csw-subjects2" onclick="switchInnerTab('subjects')"
                      style="display:inline-flex;align-items:center;gap:6px;padding:0 18px 0 0;cursor:pointer;opacity:0.55;">
                    <i class="fas fa-clipboard-list"></i>Subjects Clearance
                </span>
                <span style="color:rgba(255,255,255,0.3);margin:0 4px;">|</span>
                <span class="card-switcher active" id="csw-departmental2" onclick="switchInnerTab('departmental')"
                      style="display:inline-flex;align-items:center;gap:6px;padding:0 0 0 18px;cursor:pointer;">
                    <i class="fas fa-sitemap"></i>Departmental Clearance
                </span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Position</th>
                        <th>Signatory</th>
                        <th style="text-align:center;">Status</th>
                        <th style="text-align:center;">Requested</th>
                        <th style="text-align:center;">Cleared</th>
                        <th style="text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (allSignatories.Any())
                    {
                        foreach (var item in allSignatories)
                        {
                            bool isAdviser = item.OrgName.Equals("Class Adviser", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td style="font-weight:600;">
                                    @item.OrgName
                                    @if (isAdviser && !string.IsNullOrEmpty(item.OrgRole) &&
                                         !item.OrgRole.Equals("Class Adviser", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="font-size:11px;color:#888;font-weight:400;">@item.OrgRole</div>
                                    }
                                </td>
                                <td>@item.PersonName</td>
                                <td style="text-align:center;">
                                    @switch (item.Status)
                                    {
                                        case "Cleared":
                                            <span class="status-approved">Cleared</span>
                                            break;
                                        case "Declined":
                                            <span class="status-declined">Declined</span>
                                            break;
                                        case "Pending":
                                            <span class="status-pending">Pending</span>
                                            break;
                                        default:
                                            <span style="color:#aaa;font-size:12px;">—</span>
                                            break;
                                    }
                                </td>
                                <td style="text-align:center;">
                                    @if (item.RequestedAt.HasValue)
                                    {
                                        <span class="date-stamp">
                                            <i class="fas fa-paper-plane date-icon"></i>
                                            @item.RequestedAt.Value.ToString("MMM d, yyyy")
                                            <span class="date-time">@item.RequestedAt.Value.ToString("h:mm tt")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="date-none">—</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    @if (item.SignedAt.HasValue)
                                    {
                                        <span class="date-stamp date-stamp-signed">
                                            <i class="fas fa-check-circle date-icon"></i>
                                            @item.SignedAt.Value.ToString("MMM d, yyyy")
                                            <span class="date-time">@item.SignedAt.Value.ToString("h:mm tt")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="date-none">—</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;justify-content:center;gap:6px;">
                                        @* Request slot — always reserves space *@
                                        <div style="width:90px;display:flex;justify-content:center;">
                                            @if (string.IsNullOrEmpty(item.Status))
                                            {
                                                <button class="request-btn" onclick="requestOrg('@Html.Raw(item.OrgName)')">
                                                    <i class="fas fa-paper-plane"></i> Request
                                                </button>
                                            }
                                            else if (item.Status == "Declined")
                                            {
                                                <button class="request-btn" onclick="requestOrg('@Html.Raw(item.OrgName)')" title="Re-request clearance">
                                                    <i class="fas fa-redo me-1"></i>Re-request
                                                </button>
                                            }
                                        </div>

                                        @* Chat *@
                                        <div class="chat-btn-wrap" data-key="@item.OrgName" data-type="org">
                                            <button class="chat-icon-btn"
                                                    onclick="openChat('@item.OrgName', '@Html.Raw(item.PersonName)', 'org', '@Html.Raw(item.OrgName)')"
                                                    title="@(item.Status == "Cleared" ? "Clearance already approved" : "Message " + item.PersonName)"
                                                    @(item.Status == "Cleared" ? "disabled" : "")>
                                                <i class="fas fa-comment-dots"></i>
                                            </button>
                                            <span class="unread-dot"></span>
                                        </div>

                                        @* Delete *@
                                        <button class="delete-icon-btn"
                                                onclick="deleteClearance('@(isAdviser ? "adviser" : "org")', '@Html.Raw(item.OrgName)')"
                                                title="Delete clearance request"
                                                @(item.Status != "Pending" ? "disabled" : "")>
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="padding:40px;text-align:center;color:#888;">
                                <i class="fas fa-sitemap"
                                   style="font-size:28px;color:#ddd;display:block;margin-bottom:10px;"></i>
                                No department signatories assigned to your curriculum yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>@* end #inner-panel-departmental *@

</div>@* end #panel-clearance *@

@* ── APPROVAL REQUESTS SECTION (only for student org officers) ── *@
@if (hasApproval)
{
<div id="panel-approval" style="display:none;">

    <div class="row g-3">

        <!-- PENDING REQUESTS -->
        <div class="col-md-6">
        <div class="page-card h-100">
            <div class="page-card-hd dark">
                <i class="fas fa-clock me-2"></i>Pending Requests
                @if (Model.PendingToApprove.Any())
                {
                    <span class="badge bg-warning text-dark ms-2" style="font-size:12px;">@Model.PendingToApprove.Count pending</span>
                }
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:36px;text-align:center;">No.</th>
                            <th>Student</th>
                            <th>Course</th>
                            <th style="text-align:center;">Requested</th>
                            <th style="text-align:center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingToApprove.Any())
                        {
                            int ai = 1;
                            foreach (var item in Model.PendingToApprove)
                            {
                                <tr>
                                    <td style="text-align:center;color:#888;font-size:13px;">@ai</td>
                                    <td>
                                        <div style="font-weight:600;font-size:13px;">@item.StudentName</div>
                                        <div style="font-size:11px;color:#888;">@item.StudentNumber</div>
                                        @if (Model.MyPositions.Count >= 2)
                                        {
                                            <span style="background:#e8f5e9;color:#1a4731;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;">@item.Position</span>
                                        }
                                    </td>
                                    <td style="font-size:13px;color:#555;">@item.Course</td>
                                    <td style="text-align:center;">
                                        @if (item.RequestedAt.HasValue)
                                        {
                                            <span class="date-stamp">
                                                <i class="fas fa-paper-plane date-icon"></i>
                                                @item.RequestedAt.Value.ToString("MMM d, yyyy")
                                                <span class="date-time">@item.RequestedAt.Value.ToString("h:mm tt")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="date-none">—</span>
                                        }
                                    </td>
                                    <td style="text-align:center;">
                                        <div style="display:flex;align-items:center;justify-content:center;gap:5px;">
                                            <form asp-action="ApproveOrgRequest" asp-controller="Student" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id"       value="@item.Id" />
                                                <input type="hidden" name="periodId" value="@(Model.ActivePeriodId)" />
                                                <button type="submit" class="btn-approve"
                                                        onclick="return confirm('Approve clearance for @Html.Raw(item.StudentName)?')">
                                                    <i class="fas fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                            <form asp-action="DeclineOrgRequest" asp-controller="Student" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id"       value="@item.Id" />
                                                <input type="hidden" name="periodId" value="@(Model.ActivePeriodId)" />
                                                <button type="submit" class="btn-decline"
                                                        onclick="return confirm('Decline clearance for @Html.Raw(item.StudentName)?')">
                                                    <i class="fas fa-times me-1"></i>Decline
                                                </button>
                                            </form>
                                            <div class="chat-btn-wrap" data-sn="@item.StudentNumber" data-key="@item.Position" data-type="org">
                                                <button class="chat-icon-btn"
                                                        onclick="openSignedChat('@Html.Raw(item.StudentNumber)','@Html.Raw(item.StudentName)','@Html.Raw(item.Position)')"
                                                        title="Chat with @item.StudentName">
                                                    <i class="fas fa-comment-dots"></i>
                                                </button>
                                                <span class="unread-dot"></span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                ai++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="padding:40px;text-align:center;color:#888;">
                                    <i class="fas fa-clock" style="font-size:28px;color:#ddd;display:block;margin-bottom:10px;"></i>
                                    No pending clearance requests for this period.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        <!-- APPROVAL HISTORY -->
        <div class="col-md-6">
        <div class="page-card h-100">
            <div class="page-card-hd dark">
                <i class="fas fa-history me-2"></i>Approval History
                @if (Model.ApprovedHistory.Any())
                {
                    <span class="badge bg-secondary ms-2" style="font-size:12px;">@Model.ApprovedHistory.Count record(s)</span>
                }
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:36px;text-align:center;">No.</th>
                            <th>Student</th>
                            <th>Course</th>
                            <th style="text-align:center;">Status</th>
                            <th style="text-align:center;">Cleared</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ApprovedHistory.Any())
                        {
                            int aj = 1;
                            foreach (var item in Model.ApprovedHistory)
                            {
                                bool isCleared = item.Status == "Cleared";
                                <tr>
                                    <td style="text-align:center;color:#888;font-size:13px;">@aj</td>
                                    <td>
                                        <div style="font-weight:600;font-size:13px;">@item.StudentName</div>
                                        <div style="font-size:11px;color:#888;">@item.StudentNumber</div>
                                        @if (Model.MyPositions.Count >= 2)
                                        {
                                            <span style="background:#e8f5e9;color:#1a4731;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;">@item.Position</span>
                                        }
                                    </td>
                                    <td style="font-size:13px;color:#555;">@item.Course</td>
                                    <td style="text-align:center;">
                                        @if (isCleared)
                                        {
                                            <span class="status-approved">Cleared</span>
                                        }
                                        else if (item.Status == "Declined")
                                        {
                                            <span class="status-declined">Declined</span>
                                        }
                                        else
                                        {
                                            <span class="status-none">—</span>
                                        }
                                    </td>
                                    <td style="text-align:center;">
                                        @if (item.SignedAt.HasValue)
                                        {
                                            <span class="date-stamp @(isCleared ? "date-stamp-signed" : "date-stamp-declined")">
                                                <i class="fas @(isCleared ? "fa-check-circle" : "fa-times-circle") date-icon"></i>
                                                @item.SignedAt.Value.ToString("MMM d, yyyy")
                                                <span class="date-time">@item.SignedAt.Value.ToString("h:mm tt")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="date-none">—</span>
                                        }
                                    </td>
                                </tr>
                                aj++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="padding:40px;text-align:center;color:#888;">
                                    <i class="fas fa-history" style="font-size:28px;color:#ddd;display:block;margin-bottom:10px;"></i>
                                    No approval history for this period yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        </div>

    </div>

</div>@* end #panel-approval *@
}

