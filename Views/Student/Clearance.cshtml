function deleteClearance(type, key) {
    if (!confirm('Remove this pending clearance request?')) return;
    fetch('/Student/DeleteClearanceRequest', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
        body:    JSON.stringify({ type, key, periodId: _serverPeriodId })
    })
    .then(r => r.json())
    .then(d => { if (d.success) location.reload(); else alert(d.error ?? 'Delete failed'); })
    .catch(err => console.warn('Delete error:', err));
}

/* ══════════════════════════════════════════
   CHAT
══════════════════════════════════════════ */
let currentChatKey  = null;
let currentChatType = null;
let currentChatName = null;

function getInitials(name) {
    return (name ?? '').split(' ').filter(Boolean).map(w => w[0]).join('').slice(0, 2).toUpperCase();
}
function fmtTime(d) {
    return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
}

async function openChat(key, personName, type, role) {
    currentChatKey  = key;
    currentChatType = type;
    currentChatName = personName;
    document.getElementById('chat-name').textContent    = personName;
    document.getElementById('chat-role').textContent    = role;
    document.getElementById('chat-avatar').textContent  = getInitials(personName);
    const modal   = document.getElementById('chat-modal');
    const overlay = document.getElementById('chat-overlay');
    modal.style.display   = 'flex';
    overlay.style.display = 'block';
    document.getElementById('chat-messages').innerHTML =
        '<div style="text-align:center;margin:auto;font-size:12px;color:#aaa;">' +
        '<i class="fas fa-spinner fa-spin me-1"></i>Loading messages...</div>';
    await markRead(key, type);
    clearUnreadDot(key, type);
    fetchMessages();
    setTimeout(() => document.getElementById('chat-input').focus(), 80);
}

function closeChat() {
    document.getElementById('chat-modal').style.display   = 'none';
    document.getElementById('chat-overlay').style.display = 'none';
    currentChatKey  = null;
    currentChatType = null;
}

async function fetchMessages() {
    if (!currentChatKey) return;
    try {
        const res  = await fetch(
            `/Student/GetClearanceMessages?key=${encodeURIComponent(currentChatKey)}&type=${encodeURIComponent(currentChatType)}`
        );
        const data = await res.json();
        if (data.success) renderMessages(data.messages ?? []);
    } catch (err) { console.warn('Failed to load messages:', err); }
}

function renderMessages(msgs) {
    const box = document.getElementById('chat-messages');
    box.innerHTML = '';
    if (!msgs.length) {
        box.innerHTML = `
            <div style="text-align:center;margin:auto;">
                <div style="font-size:32px;margin-bottom:10px;">💬</div>
                <div style="font-size:13px;font-weight:700;color:#1a1a2e;margin-bottom:4px;">Start the conversation</div>
                <div style="font-size:12px;color:#aaa;max-width:220px;margin:0 auto;line-height:1.6;">
                    Send a message to <strong>${escHtml(currentChatName)}</strong> about your clearance.
                </div>
            </div>`;
        return;
    }
    let lastDate = null;
    msgs.forEach(m => {
        const d       = new Date(m.time);
        const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        if (dateStr !== lastDate) {
            const div       = document.createElement('div');
            div.className   = 'chat-date-divider';
            div.textContent = dateStr;
            box.appendChild(div);
            lastDate = dateStr;
        }
        const wrap     = document.createElement('div');
        wrap.className = 'chat-bubble-wrap ' + (m.mine ? 'mine' : 'theirs');
        if (!m.mine) {
            const sn       = document.createElement('div');
            sn.className   = 'chat-sender-name';
            sn.textContent = currentChatName;
            wrap.appendChild(sn);
        }
        const bubble       = document.createElement('div');
        bubble.className   = 'chat-bubble ' + (m.mine ? 'mine' : 'theirs');
        bubble.textContent = m.text;
        wrap.appendChild(bubble);
        const time       = document.createElement('div');
        time.className   = 'chat-time';
        time.textContent = fmtTime(d);
        wrap.appendChild(time);
        box.appendChild(wrap);
    });
    box.scrollTop = box.scrollHeight;
}

async function sendChatMessage() {
    const input = document.getElementById('chat-input');
    const text  = input.value.trim();
    if (!text || !currentChatKey) return;
    const existingMsgs = Array.from(document.querySelectorAll('#chat-messages .chat-bubble-wrap')).length > 0;
    input.value = '';
    const tempMsg = { mine: true, text, time: new Date().toISOString() };
    if (!existingMsgs) {
        renderMessages([tempMsg]);
    } else {
        appendBubble(tempMsg);
        document.getElementById('chat-messages').scrollTop = 999999;
    }
    try {
        await fetch('/Student/SendClearanceMessage', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body: JSON.stringify({ clearanceType: currentChatType, clearanceKey: currentChatKey, message: text })
        });
    } catch (err) { console.warn('Chat error:', err); }
}

function appendBubble(m) {
    const box  = document.getElementById('chat-messages');
    const wrap = document.createElement('div');
    wrap.className = 'chat-bubble-wrap ' + (m.mine ? 'mine' : 'theirs');
    const bubble       = document.createElement('div');
    bubble.className   = 'chat-bubble ' + (m.mine ? 'mine' : 'theirs');
    bubble.textContent = m.text;
    wrap.appendChild(bubble);
    const time       = document.createElement('div');
    time.className   = 'chat-time';
    time.textContent = fmtTime(new Date(m.time));
    wrap.appendChild(time);
    box.appendChild(wrap);
}

/* ══════════════════════════════════════════
   SIGNED CHAT (officer ↔ student)
══════════════════════════════════════════ */
let _scSN = null, _scName = null, _scKey = null;

async function openSignedChat(sn, name, position) {
    _scSN = sn; _scName = name; _scKey = position;
    document.getElementById('sc-chat-name').textContent   = name;
    document.getElementById('sc-chat-sub').textContent    = position;
    document.getElementById('sc-chat-avatar').textContent = getInitials(name);
    document.getElementById('sc-chat-modal').style.display   = 'flex';
    document.getElementById('sc-chat-overlay').style.display = 'block';
    document.getElementById('sc-chat-messages').innerHTML =
        '<div style="text-align:center;margin:auto;font-size:12px;color:#aaa;"><i class="fas fa-spinner fa-spin me-1"></i>Loading…</div>';
    try {
        await fetch('/Student/MarkMessagesRead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body: JSON.stringify({ clearanceKey: position, clearanceType: 'org', studentNumber: sn, message: '' })
        });
    } catch {}
    clearUnreadDot(position, 'org', sn);
    try {
        const res = await fetch(`/Student/GetClearanceMessages?key=${encodeURIComponent(position)}&type=org&studentNumber=${encodeURIComponent(sn)}`);
        const d   = await res.json();
        if (d.success) renderSignedMessages(d.messages ?? []);
    } catch {
        document.getElementById('sc-chat-messages').innerHTML =
            '<div style="text-align:center;color:#aaa;padding:24px;">Could not load messages.</div>';
    }
    setTimeout(() => document.getElementById('sc-chat-input').focus(), 80);
}

function closeSignedChat() {
    document.getElementById('sc-chat-modal').style.display   = 'none';
    document.getElementById('sc-chat-overlay').style.display = 'none';
    _scSN = null;
}

function renderSignedMessages(msgs) {
    const box = document.getElementById('sc-chat-messages');
    box.innerHTML = '';
    if (!msgs.length) {
        box.innerHTML = `<div style="text-align:center;margin:auto;">
            <div style="font-size:32px;margin-bottom:10px;">💬</div>
            <div style="font-size:13px;font-weight:700;color:#1a1a2e;margin-bottom:4px;">Start the conversation</div>
            <div style="font-size:12px;color:#aaa;">Send a message to <strong>${escHtml(_scName)}</strong>.</div>
        </div>`;
        return;
    }
    let lastDate = null;
    msgs.forEach(m => {
        const d  = new Date(m.time);
        const ds = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        if (ds !== lastDate) {
            const div = document.createElement('div');
            div.style.cssText = 'text-align:center;font-size:10px;color:#aaa;margin:6px 0;';
            div.textContent = ds;
            box.appendChild(div);
            lastDate = ds;
        }
        const wrap = document.createElement('div');
        wrap.className = 'chat-bubble-wrap ' + (m.mine ? 'mine' : 'theirs');
        if (!m.mine) {
            const sn = document.createElement('div');
            sn.className = 'chat-sender-name';
            sn.textContent = _scName;
            wrap.appendChild(sn);
        }
        const bubble = document.createElement('div');
        bubble.className = 'chat-bubble ' + (m.mine ? 'mine' : 'theirs');
        bubble.textContent = m.text;
        wrap.appendChild(bubble);
        const time = document.createElement('div');
        time.className = 'chat-time';
        time.textContent = fmtTime(d);
        wrap.appendChild(time);
        box.appendChild(wrap);
    });
    box.scrollTop = box.scrollHeight;
}

async function sendSignedChat() {
    const input = document.getElementById('sc-chat-input');
    const text  = input.value.trim();
    if (!text || !_scSN) return;
    input.value = '';
    const wrap = document.createElement('div'); wrap.className = 'chat-bubble-wrap mine';
    const b    = document.createElement('div'); b.className = 'chat-bubble mine'; b.textContent = text;
    const t    = document.createElement('div'); t.className = 'chat-time'; t.textContent = fmtTime(new Date());
    wrap.appendChild(b); wrap.appendChild(t);
    const box = document.getElementById('sc-chat-messages');
    box.appendChild(wrap); box.scrollTop = box.scrollHeight;
    try {
        await fetch('/Student/SendClearanceMessage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
            body: JSON.stringify({ clearanceKey: _scKey, clearanceType: 'org', studentNumber: _scSN, message: text })
        });
    } catch {}
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeChat(); closeSignedChat(); } });

/* ── Init ── */
buildPeriodDropdown();
loadUnreadBadges();
setInterval(loadUnreadBadges, 30000);
</script>
}
