@model OnlineClearanceSystem.Models.StudentDashboardViewModel
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    /* ── SPLASH CHECKLIST ── */
    .splash-step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 18px;
        transition: background 0.2s;
        border-radius: 8px;
        margin: 2px 8px;
    }
    .splash-step:hover { background: #f8fafb; }
    .splash-step.done  { opacity: 0.65; }
    .splash-step.done .splash-title { text-decoration: line-through; color: #aaa; }

    .splash-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }
    .splash-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        transition: transform 0.2s;
    }
    .splash-step.done .splash-circle { filter: grayscale(0.4); }
    .splash-step:hover .splash-circle { transform: scale(1.1); }

    .splash-line {
        width: 2px;
        flex: 1;
        min-height: 18px;
        background: linear-gradient(to bottom, #dee2e6, transparent);
        margin-top: 4px;
    }

    .splash-body { flex: 1; min-width: 0; padding-top: 2px; }
    .splash-num   { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 2px; }
    .splash-title { font-size: 13px; font-weight: 700; color: #1a1a2e; margin-bottom: 3px; }
    .splash-desc  { font-size: 11px; color: #888; line-height: 1.6; }

    .splash-check {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        margin-top: 6px;
        transition: all 0.2s;
        background: white;
    }
    .splash-check i { font-size: 10px; display: none; }
    .splash-check.ticked { background: currentColor !important; }
    .splash-check.ticked i { display: block; color: white !important; }

    /* ── SPLASH ANIMATIONS ── */
    @@keyframes notifySlideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes checklistGlow {
        0%,100% { box-shadow: 0 0 0 0 rgba(224,123,42,0.5); }
        50%      { box-shadow: 0 0 0 10px rgba(224,123,42,0); }
    }
    @@keyframes bellRing {
        0%,100% { transform: rotate(0); }
        10%      { transform: rotate(-18deg); }
        20%      { transform: rotate(18deg); }
        30%      { transform: rotate(-12deg); }
        40%      { transform: rotate(12deg); }
        50%      { transform: rotate(0); }
    }
    .splash-bell   { animation: bellRing 1.4s ease infinite; transform-origin: top center; }
    .checklist-active { animation: checklistGlow 2s ease infinite; border-radius: 12px; }

    /* ── MINI STATS GRID ── */
    .mini-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1px solid #e9ecef;
    }
    .mini-stat {
        padding: 12px 16px;
        border-right: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }
    .mini-stat:nth-child(even) { border-right: none; }
    .mini-stat:nth-last-child(-n+2) { border-bottom: none; }
    .mini-stat-num   { font-size: 22px; font-weight: 800; line-height: 1; }
    .mini-stat-label { font-size: 11px; color: #888; margin-top: 3px; }

    /* ── ANNOUNCEMENT TABS ── */
    .ann-tab {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        letter-spacing: 0.4px;
        background: #ffffff;
        color: #111;
        border: 2px solid transparent;
    }

    /* Default (unselected) — white bg, black text, colored border */
    .ann-tab.tab-all     { border-color: #28a745; }
    .ann-tab.tab-urgent  { border-color: #dc3545; }
    .ann-tab.tab-pinned  { border-color: #0d6efd; }
    .ann-tab.tab-events  { border-color: #1a4731; }
    .ann-tab.tab-general { border-color: #d4a017; }

    /* Active (selected) — filled bg, white text */
    .ann-tab.tab-all.active     { background: #28a745; color: #fff; border-color: #28a745; }
    .ann-tab.tab-urgent.active  { background: #dc3545; color: #fff; border-color: #dc3545; }
    .ann-tab.tab-pinned.active  { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .ann-tab.tab-events.active  { background: #1a4731; color: #fff; border-color: #1a4731; }
    .ann-tab.tab-general.active { background: #d4a017; color: #fff; border-color: #d4a017; }

    /* ── ANNOUNCEMENT PANEL HEADER ── */
    .ann-panel-header {
        background: var(--green, #28a745);
        color: white;
        padding: 13px 18px;
        border-radius: 12px 12px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        font-size: 14px;
    }

    /* ── ANNOUNCEMENT PANEL BODY ── */
    .ann-panel-body {
        background: white;
        padding: 16px 18px 18px;
    }
</style>

<!-- ── STEPS MODAL ── -->
<div id="steps-modal" onclick="if(event.target===this)closeStepsModal()"
     style="display:none;opacity:0;position:fixed;inset:0;z-index:9999;
            background:rgba(0,0,0,0.45);backdrop-filter:blur(3px);
            align-items:center;justify-content:center;
            transition:opacity 0.3s ease;">
    <div style="background:white;border-radius:16px;width:92%;max-width:460px;
                max-height:88vh;overflow-y:auto;
                box-shadow:0 24px 64px rgba(0,0,0,0.3);
                transition:transform 0.3s ease;" id="steps-modal-card">
        <div style="background:linear-gradient(135deg,#1a4731,#2d6a4f);color:white;
                    padding:16px 20px;border-radius:16px 16px 0 0;
                    display:flex;justify-content:space-between;align-items:center;
                    position:sticky;top:0;z-index:1;">
            <span style="font-weight:800;font-size:14px;letter-spacing:0.3px;">
                <i class="fas fa-list-ol me-2"></i>Clearance Steps
            </span>
            <button onclick="closeStepsModal()"
                    style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);
                           color:white;border-radius:50%;width:30px;height:30px;
                           display:flex;align-items:center;justify-content:center;
                           font-size:14px;cursor:pointer;flex-shrink:0;transition:background 0.2s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.3)'"
                    onmouseout="this.style.background='rgba(255,255,255,0.15)'">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div style="padding:4px 0 12px;">
            @{
                var steps = new[] {
                    new { icon="fa-book-open",    color="#1a7a46", bg="#e6f4ea", title="Select Enrolled Subjects",  desc="Choose the subjects you are enrolled in this semester." },
                    new { icon="fa-check-double", color="#1565c0", bg="#e3f2fd", title="Confirm Enrolled Subjects",  desc="Confirm your selection and submit to your assigned instructors." },
                    new { icon="fa-user-check",   color="#7b1fa2", bg="#f3e5f5", title="Instructor Approval",        desc="Wait for your subject instructors to sign off on your clearance." },
                    new { icon="fa-sitemap",      color="#e65100", bg="#fff3e0", title="Organization Approval",      desc="Secure approval from each organization signatory." },
                    new { icon="fa-file-download",color="#c9a84c", bg="#fdf8e1", title="Download & Print",          desc="Download your clearance PDF once all signatories are complete." },
                };
                int stepNum = 1;
            }
            @foreach (var s in steps)
            {
                <div class="splash-step" data-step="@stepNum">
                    <div class="splash-left">
                        <div class="splash-circle" style="background:@s.bg;color:@s.color;">
                            <i class="fas @s.icon"></i>
                        </div>
                        @if (stepNum < steps.Length)
                        {
                            <div class="splash-line"></div>
                        }
                    </div>
                    <div class="splash-body">
                        <div class="splash-num" style="color:@s.color;">Step @stepNum</div>
                        <div class="splash-title">@s.title</div>
                        <div class="splash-desc">@s.desc</div>
                    </div>
                </div>
                stepNum++;
            }
        </div>
    </div>
</div>

<!-- ── CHECKLIST + ANNOUNCEMENTS ── -->
<div style="display:flex;flex-direction:column;height:calc(100vh - 100px);gap:10px;">

    <!-- CLEARANCE STATUS -->
    <div>
        <div class="page-card" style="position:relative;overflow:hidden;">
            <!-- Header -->
            <div style="background:linear-gradient(135deg,#1a4731,#2d6a4f);color:white;
                        padding:12px 20px;display:flex;justify-content:space-between;align-items:center;
                        border-radius:12px 12px 0 0;">
                <span style="font-weight:800;font-size:14px;letter-spacing:0.3px;">
                    <i class="fas fa-clipboard-check me-2"></i>Clearance Status
                </span>
                <span style="font-size:11px;color:rgba(255,255,255,0.7);">@(Model?.ActivePeriod ?? "—")</span>
            </div>

            <!-- PAGE 1: Pending Notification -->
            <div id="page-notify" style="transition:opacity 0.5s ease;">
                @{
                    var subjTotal  = Model?.TotalSubjects   ?? 0;
                    var subjDone   = Model?.SubjectCleared  ?? 0;
                    var orgTotal   = Model?.TotalOrgs       ?? 0;
                    var orgDone    = Model?.OrgCleared      ?? 0;
                    var allClear   = subjTotal > 0 && subjDone == subjTotal && orgTotal > 0 && orgDone == orgTotal;
                    var subjPct    = subjTotal > 0 ? (int)Math.Round((double)subjDone / subjTotal * 100) : 0;
                    var orgPct     = orgTotal  > 0 ? (int)Math.Round((double)orgDone  / orgTotal  * 100) : 0;
                }
                <div style="padding:8px 14px 10px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">

                    <!-- Status badge -->
                    @if (allClear)
                    {
                        <span style="background:#e6f9f0;color:#1a7a46;border:1px solid rgba(26,122,70,0.2);
                                     border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700;white-space:nowrap;">
                            <i class="fas fa-check-circle me-1"></i>ALL CLEAR
                        </span>
                    }
                    else
                    {
                        <span style="background:#fff8f2;color:#e07b2a;border:1px solid rgba(224,123,42,0.2);
                                     border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700;white-space:nowrap;">
                            <i class="fas fa-hourglass-half me-1"></i>IN PROGRESS
                        </span>
                    }

                    <div style="width:1px;height:28px;background:#e9ecef;"></div>

                    <!-- Subjects inline -->
                    <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:120px;">
                        <i class="fas fa-book" style="color:#1565c0;font-size:12px;"></i>
                        <div style="flex:1;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
                                <span style="font-size:11px;font-weight:600;color:#555;">Subjects</span>
                                <span style="font-size:11px;font-weight:700;color:#1565c0;">@subjDone/@subjTotal</span>
                            </div>
                            <div style="height:5px;background:#dbeafe;border-radius:4px;overflow:hidden;">
                                <div style="height:100%;width:@(subjPct)%;background:linear-gradient(90deg,#1565c0,#42a5f5);
                                            border-radius:4px;transition:width 0.8s ease;"></div>
                            </div>
                        </div>
                    </div>

                    <div style="width:1px;height:28px;background:#e9ecef;"></div>

                    <!-- Organizations inline -->
                    <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:120px;">
                        <i class="fas fa-sitemap" style="color:#7b1fa2;font-size:12px;"></i>
                        <div style="flex:1;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
                                <span style="font-size:11px;font-weight:600;color:#555;">Organizations</span>
                                <span style="font-size:11px;font-weight:700;color:#7b1fa2;">@orgDone/@orgTotal</span>
                            </div>
                            <div style="height:5px;background:#f3e5f5;border-radius:4px;overflow:hidden;">
                                <div style="height:100%;width:@(orgPct)%;background:linear-gradient(90deg,#7b1fa2,#ce93d8);
                                            border-radius:4px;transition:width 0.8s ease;"></div>
                            </div>
                        </div>
                    </div>

                    @if (Model?.HasOrgPosition == true)
                    {
                        <div style="width:1px;height:28px;background:#e9ecef;"></div>

                        <!-- Org Requests (only for position holders) -->
                        <div style="display:flex;align-items:center;gap:8px;min-width:100px;">
                            <i class="fas fa-pen-nib" style="color:#0d7b4e;font-size:12px;"></i>
                            <div>
                                <div style="font-size:10px;font-weight:600;color:#555;">Org Requests</div>
                                <div style="display:flex;align-items:baseline;gap:4px;">
                                    <span style="font-size:17px;font-weight:800;color:#0d7b4e;line-height:1;">@Model.PendingToSign</span>
                                    <span style="font-size:10px;color:#888;">pending</span>
                                </div>
                            </div>
                            @if (Model.PendingToSign > 0)
                            {
                                <span style="background:#0d7b4e;color:white;border-radius:50%;
                                             width:18px;height:18px;font-size:10px;font-weight:700;
                                             display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    @Model.PendingToSign
                                </span>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>

    <!-- ANNOUNCEMENTS (fills remaining height) -->
    <div style="flex:1;min-height:0;display:flex;flex-direction:column;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.07);">
        <div class="ann-panel-header">
            <span><i class="fas fa-bullhorn me-2"></i>Announcements</span>
        </div>
        <div class="ann-panel-body" style="flex:1;max-height:none;overflow-y:auto;border-radius:0 0 12px 12px;">

            <!-- FILTER TABS -->
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <button class="ann-tab tab-all active"    onclick="filterAnn('all',this)">ALL</button>
                <button class="ann-tab tab-urgent"        onclick="filterAnn('Urgent',this)">URGENT</button>
                <button class="ann-tab tab-pinned"        onclick="filterAnn('Pinned',this)">
                    <i class="fas fa-thumbtack me-1"></i>PINNED
                </button>
                <button class="ann-tab tab-events"        onclick="filterAnn('Event',this)">EVENTS</button>
                <button class="ann-tab tab-general"       onclick="filterAnn('General',this)">GENERAL</button>
            </div>

            <!-- ANNOUNCEMENT LIST -->
            <div id="ann-list">
                @if (Model?.Announcements != null && Model.Announcements.Any())
                {
                    @foreach (var ann in Model.Announcements)
                    {
                        <div class="ann-card" data-tag="@ann.Type.ToLower()">
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ann-avatar">A</div>
                                    <div>
                                        <div style="font-weight:700;font-size:13px;color:#1a1a2e;">Admin</div>
                                        <div style="font-size:11px;color:#888;">System Administrator</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @{ var t = (ann.Type ?? "General").ToLower(); }
                                    @if (t == "pinned") {
                                        <span class="ann-tag tag-pinned"><i class="fas fa-thumbtack me-1"></i>Pinned</span>
                                    }
                                    <span class="ann-tag tag-@t">@ann.Type.ToUpper()</span>
                                    <span style="font-size:11px;color:#888;">@ann.Date</span>
                                </div>
                            </div>
                            <div style="font-weight:700;font-size:15px;color:#1a1a2e;margin-bottom:8px;">@ann.Title</div>
                            <div style="font-size:13px;color:#555;line-height:1.7;white-space:pre-wrap;">@ann.Content</div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center;padding:40px 24px;color:#888;">
                        <i class="fas fa-bullhorn"
                           style="font-size:32px;color:#ddd;margin-bottom:12px;display:block;"></i>
                        <div style="font-size:14px;font-weight:600;color:#aaa;">No announcements yet</div>
                        <div style="font-size:12px;margin-top:4px;">
                            Check back later for updates from the Admin.
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterAnn(tag, btn) {
        document.querySelectorAll('.ann-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#ann-list .ann-card').forEach(c => {
            c.style.display = tag === 'all'
                ? ''
                : (c.dataset.tag || '').toLowerCase()
                    .includes(tag.toLowerCase()) ? '' : 'none';
        });
    }

    function closeStepsModal() {
        var m = document.getElementById('steps-modal');
        m.style.opacity = '0';
        setTimeout(function() {
            m.style.display = 'none';
        }, 300);
    }

    window.addEventListener('DOMContentLoaded', function() {
        var SPLASH_KEY = 'splashShown_student';
        var m = document.getElementById('steps-modal');

        if (!sessionStorage.getItem(SPLASH_KEY)) {
            sessionStorage.setItem(SPLASH_KEY, '1');
            m.style.display = 'flex';
            setTimeout(function() { m.style.opacity = '1'; }, 10);
        }
    });
</script>
}
