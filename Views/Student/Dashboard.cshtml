@model OnlineClearanceSystem.Models.StudentDashboardViewModel
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    /* ── SPLASH CHECKLIST ── */
    .splash-step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 18px;
        transition: background 0.2s;
        border-radius: 8px;
        margin: 2px 8px;
    }
    .splash-step:hover { background: #f8fafb; }
    .splash-step.done  { opacity: 0.65; }
    .splash-step.done .splash-title { text-decoration: line-through; color: #aaa; }

    .splash-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }
    .splash-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        transition: transform 0.2s;
    }
    .splash-step.done .splash-circle { filter: grayscale(0.4); }
    .splash-step:hover .splash-circle { transform: scale(1.1); }

    .splash-line {
        width: 2px;
        flex: 1;
        min-height: 18px;
        background: linear-gradient(to bottom, #dee2e6, transparent);
        margin-top: 4px;
    }

    .splash-body { flex: 1; min-width: 0; padding-top: 2px; }
    .splash-num   { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 2px; }
    .splash-title { font-size: 13px; font-weight: 700; color: #1a1a2e; margin-bottom: 3px; }
    .splash-desc  { font-size: 11px; color: #888; line-height: 1.6; }

    .splash-check {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        margin-top: 6px;
        transition: all 0.2s;
        background: white;
    }
    .splash-check i { font-size: 10px; display: none; }
    .splash-check.ticked { background: currentColor !important; }
    .splash-check.ticked i { display: block; color: white !important; }

    /* ── STAT ROW ── */
    .stat-row {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
        align-items: stretch;
    }

    /* ── STAT CARD ── */
    .stat-card {
        flex: 1 1 0;
        border-radius: 12px;
        padding: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: none;
        min-width: 0;
        min-height: 100px;
    }
    .stat-card.green-card  { background: linear-gradient(135deg, #1e7a46, #28a745); }
    .stat-card.orange-card { background: linear-gradient(135deg, #b8560a, #e07b2a); }
    .stat-card.blue-card   { background: linear-gradient(135deg, #1a5fa8, #3182ce); }

    .stat-num   { font-size: 28px; font-weight: 800; color: #ffffff; line-height: 1; }
    .stat-label { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.9); margin-top: 3px; }
    .stat-sub   { font-size: 11px; color: rgba(255,255,255,0.65); margin-top: 2px; }

    .stat-icon-wrap {
        width: 48px; height: 48px;
        border-radius: 12px;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        color: white;
        flex-shrink: 0;
    }

    /* ── ANNOUNCEMENT TABS ── */
    .ann-tab {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        letter-spacing: 0.4px;
        background: #ffffff;
        color: #111;
        border: 2px solid transparent;
    }

    /* Default (unselected) — white bg, black text, colored border */
    .ann-tab.tab-all     { border-color: #28a745; }
    .ann-tab.tab-urgent  { border-color: #dc3545; }
    .ann-tab.tab-pinned  { border-color: #0d6efd; }
    .ann-tab.tab-events  { border-color: #1a4731; }
    .ann-tab.tab-general { border-color: #d4a017; }

    /* Active (selected) — filled bg, white text */
    .ann-tab.tab-all.active     { background: #28a745; color: #fff; border-color: #28a745; }
    .ann-tab.tab-urgent.active  { background: #dc3545; color: #fff; border-color: #dc3545; }
    .ann-tab.tab-pinned.active  { background: #0d6efd; color: #fff; border-color: #0d6efd; }
    .ann-tab.tab-events.active  { background: #1a4731; color: #fff; border-color: #1a4731; }
    .ann-tab.tab-general.active { background: #d4a017; color: #fff; border-color: #d4a017; }

    /* ── ANNOUNCEMENT PANEL HEADER ── */
    .ann-panel-header {
        background: var(--green, #28a745);
        color: white;
        padding: 13px 18px;
        border-radius: 12px 12px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        font-size: 14px;
    }

    /* ── ANNOUNCEMENT PANEL BODY ── */
    .ann-panel-body {
        background: white;
        border-radius: 0 0 12px 12px;
        padding: 16px 18px 18px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.07);
    }
</style>

<!-- ── STAT ROW (3 cards only, period card removed) ── -->
<div class="col-lg-8">
    <div class="stat-row">

        <!-- SUBJECT CLEARED -->
        <div class="stat-card green-card">
            <div>
                <div class="stat-num">@(Model?.SubjectCleared ?? 0)</div>
                <div class="stat-label">Subjects Cleared</div>
                <div class="stat-sub">Total Subjects</div>
            </div>
            <div class="stat-icon-wrap">
                <i class="fas fa-clipboard-check"></i>
            </div>
        </div>

        <!-- SUBJECT PENDING -->
        <div class="stat-card orange-card">
            <div>
                <div class="stat-num">@(Model?.SubjectIncomplete ?? 0)</div>
                <div class="stat-label">Subject Pending</div>
            </div>
            <div class="stat-icon-wrap">
                <i class="fas fa-clock"></i>
            </div>
        </div>

        <!-- ORGANIZATION CLEARED -->
        <div class="stat-card blue-card">
            <div>
                <div class="stat-num">@(Model?.OrgCleared ?? 0)</div>
                <div class="stat-label">Organizations Cleared</div>
            </div>
            <div class="stat-icon-wrap">
                <i class="fas fa-sitemap"></i>
            </div>
        </div>

    </div>
</div>

    <!-- ── CHECKLIST + ANNOUNCEMENTS ── -->
<div class="row g-3">

    <!-- CHECKLIST -->
    <div class="col-md-5">
        <div class="page-card" style="overflow:visible;">
            <!-- Header -->
            <div style="background:linear-gradient(135deg,#1a4731,#2d6a4f);color:white;
                        padding:16px 20px;display:flex;justify-content:space-between;align-items:center;
                        border-radius:12px 12px 0 0;">
                <span style="font-weight:800;font-size:14px;letter-spacing:0.3px;">
                    <i class="fas fa-tasks me-2"></i>Clearance Checklist
                </span>
                <span id="progress-badge"
                      style="background:rgba(255,255,255,0.22);border:1px solid rgba(255,255,255,0.35);
                             border-radius:20px;padding:4px 13px;font-size:11px;font-weight:700;">
                    0 / 5 Done
                </span>
            </div>

            <!-- Progress bar -->
            <div style="height:4px;background:#e9ecef;">
                <div id="progress-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#28a745,#34c759);
                     transition:width 0.4s ease;border-radius:0 4px 4px 0;"></div>
            </div>

            <!-- Steps -->
            <div style="padding:4px 0 8px;">
                @{
                    var steps = new[] {
                        new { icon="fa-book-open",    color="#1a7a46", bg="#e6f4ea", title="Select Enrolled Subjects",       desc="Choose the subjects you are enrolled in this semester." },
                        new { icon="fa-check-double", color="#1565c0", bg="#e3f2fd", title="Confirm Enrolled Subjects",       desc="Confirm your selection and submit to your assigned instructors." },
                        new { icon="fa-user-check",   color="#7b1fa2", bg="#f3e5f5", title="Instructor Approval",             desc="Wait for your subject instructors to sign off on your clearance." },
                        new { icon="fa-sitemap",      color="#e65100", bg="#fff3e0", title="Organization Approval",           desc="Secure approval from each organization signatory." },
                        new { icon="fa-file-download",color="#c9a84c", bg="#fdf8e1", title="Download & Print",               desc="Download your clearance PDF once all signatories are complete." },
                    };
                    int stepNum = 1;
                }
                @foreach (var s in steps)
                {
                    <div class="splash-step" data-step="@stepNum">
                        <div class="splash-left">
                            <div class="splash-circle" style="background:@s.bg;color:@s.color;">
                                <i class="fas @s.icon"></i>
                            </div>
                            @if (stepNum < steps.Length)
                            {
                                <div class="splash-line"></div>
                            }
                        </div>
                        <div class="splash-body">
                            <div class="splash-num" style="color:@s.color;">Step @stepNum</div>
                            <div class="splash-title">@s.title</div>
                            <div class="splash-desc">@s.desc</div>
                        </div>
                        <div class="splash-check" onclick="toggleStep(this)"
                             style="border-color:@s.color;">
                            <i class="fas fa-check" style="color:@s.color;"></i>
                        </div>
                    </div>
                    stepNum++;
                }
            </div>
        </div>
    </div>

    <!-- ANNOUNCEMENTS -->
    <div class="col-md-7">
        <div class="ann-panel-header">
            <span><i class="fas fa-bullhorn me-2"></i>Announcements</span>
        </div>
        <div class="ann-panel-body">

            <!-- FILTER TABS -->
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <button class="ann-tab tab-all active"    onclick="filterAnn('all',this)">ALL</button>
                <button class="ann-tab tab-urgent"        onclick="filterAnn('Urgent',this)">URGENT</button>
                <button class="ann-tab tab-pinned"        onclick="filterAnn('Pinned',this)">
                    <i class="fas fa-thumbtack me-1"></i>PINNED
                </button>
                <button class="ann-tab tab-events"        onclick="filterAnn('Event',this)">EVENTS</button>
                <button class="ann-tab tab-general"       onclick="filterAnn('General',this)">GENERAL</button>
            </div>

            <!-- ANNOUNCEMENT LIST -->
            <div id="ann-list">
                @if (Model?.Announcements != null && Model.Announcements.Any())
                {
                    @foreach (var ann in Model.Announcements)
                    {
                        <div class="ann-card" data-tag="@ann.Type.ToLower()">
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="ann-avatar">A</div>
                                    <div>
                                        <div style="font-weight:700;font-size:13px;color:#1a1a2e;">Admin</div>
                                        <div style="font-size:11px;color:#888;">System Administrator</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @{ var t = (ann.Type ?? "General").ToLower(); }
                                    @if (t == "pinned") {
                                        <span class="ann-tag tag-pinned"><i class="fas fa-thumbtack me-1"></i>Pinned</span>
                                    }
                                    <span class="ann-tag tag-@t">@ann.Type.ToUpper()</span>
                                    <span style="font-size:11px;color:#888;">@ann.Date</span>
                                </div>
                            </div>
                            <div style="font-weight:700;font-size:15px;color:#1a1a2e;margin-bottom:8px;">@ann.Title</div>
                            <div style="font-size:13px;color:#555;line-height:1.7;white-space:pre-wrap;">@ann.Content</div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center;padding:40px 24px;color:#888;">
                        <i class="fas fa-bullhorn"
                           style="font-size:32px;color:#ddd;margin-bottom:12px;display:block;"></i>
                        <div style="font-size:14px;font-weight:600;color:#aaa;">No announcements yet</div>
                        <div style="font-size:12px;margin-top:4px;">
                            Check back later for updates from the Admin.
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterAnn(tag, btn) {
        // Remove active from all tabs
        document.querySelectorAll('.ann-tab').forEach(b => b.classList.remove('active'));
        // Set active on clicked tab
        btn.classList.add('active');
        // Show/hide announcement cards
        document.querySelectorAll('#ann-list .ann-card').forEach(c => {
            c.style.display = tag === 'all'
                ? ''
                : (c.dataset.tag || '').toLowerCase()
                    .includes(tag.toLowerCase()) ? '' : 'none';
        });
    }

    function toggleStep(checkEl) {
        const step    = checkEl.closest('.splash-step');
        const ticked  = checkEl.classList.toggle('ticked');
        step.classList.toggle('done', ticked);

        const total   = document.querySelectorAll('.splash-step').length;
        const checked = document.querySelectorAll('.splash-check.ticked').length;
        const pct     = Math.round(checked / total * 100);

        document.getElementById('progress-badge').textContent = `${checked} / ${total} Done`;
        document.getElementById('progress-bar').style.width   = pct + '%';
    }
</script>
}
