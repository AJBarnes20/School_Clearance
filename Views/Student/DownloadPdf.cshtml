@model OnlineClearanceSystem.Models.StudentClearancePdfViewModel
@{
    ViewData["Title"]      = "Download Clearance";
    ViewData["ActivePage"] = "DownloadPdf";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    string sem = "";
    string ay  = "";
    if (!string.IsNullOrEmpty(Model?.AySemester))
    {
        var parts = Model.AySemester.Split(',', 2);
        if (parts.Length == 2) { sem = parts[0].Trim(); ay = parts[1].Replace("A.Y.","").Trim(); }
        else sem = Model.AySemester;
    }

    string courseSection = (Model?.CourseYear ?? "")
        + (string.IsNullOrEmpty(Model?.Section) ? "" : ", " + Model.Section);

    var orgList = Model?.Organizations
                  ?? new List<OnlineClearanceSystem.Models.PdfOrganizationItem>();

    var classAdviser = orgList.FirstOrDefault(o =>
        string.Equals(o.OrgName, "Class Adviser", StringComparison.OrdinalIgnoreCase));
    var deptChair = orgList.FirstOrDefault(o =>
        string.Equals(o.OrgName, "Department Chairperson", StringComparison.OrdinalIgnoreCase));

    var leftSlots = orgList
    .Where(o => !string.Equals(o.OrgName, "Class Adviser",          StringComparison.OrdinalIgnoreCase)
             && !string.Equals(o.OrgName, "Department Chairperson", StringComparison.OrdinalIgnoreCase)
             && !string.Equals(o.OrgName, "Organization Adviser",   StringComparison.OrdinalIgnoreCase))
    .ToList();

    // ── Periods passed from server — no AJAX needed (same as Clearance page) ──
    var periodsJson = ViewBag.Periods as string ?? "[]";

    string PersonDisplay(string? name) =>
        (!string.IsNullOrWhiteSpace(name)
          && !string.Equals(name, "TBA",  StringComparison.OrdinalIgnoreCase)
          && !string.Equals(name, "—",    StringComparison.Ordinal))
            ? name! : "";
}

@functions {
    string FillLine(string? v) =>
        $"<span class=\"line\">&nbsp;{System.Net.WebUtility.HtmlEncode(v ?? "")}&nbsp;</span>";
}

<link rel="stylesheet" href="~/css/download-pdf.css" asp-append-version="true" />

<!-- TOOLBAR -->
<div id="toolbar">
    <div class="toolbar-left">
        <div class="period-selector-wrap" id="period-wrap">
            <button class="period-btn" id="period-btn" onclick="togglePeriodDd(event)" type="button">
                <div class="period-btn-icon"><i class="fas fa-calendar-alt"></i></div>
                <div class="period-btn-text">
                    <div class="period-btn-label">Academic Period</div>
                    <div class="period-btn-value" id="period-btn-value">
                        @(string.IsNullOrEmpty(Model?.AySemester) ? "Select Period" : Model!.AySemester)
                    </div>
                </div>
                <i class="fas fa-chevron-down period-chevron"></i>
            </button>
            <div class="period-dd" id="period-dd">
                <!-- Populated by buildPeriodDropdown() -->
            </div>
        </div>
    </div>
    <div class="toolbar-right">
        <button class="btn-print" onclick="doPrint()" type="button">
            <i class="fas fa-print"></i>&nbsp; Print / Download
        </button>
    </div>
</div>

<!-- PRINTABLE DOCUMENT -->
<div id="pdf-preview">
<div id="sheet">

@{
    void RenderCard()
    {
        <section class="card">
            <!-- HEADER -->
            <div class="hdr">
                <img class="hdr-logo" src="/images/Cebu_Technological_University_Logo.png" alt="CTU" />
                <div class="hdr-text">
                    <div class="hdr-rep">Republic of the Philippines</div>
                    <div class="hdr-uni">CEBU TECHNOLOGICAL UNIVERSITY</div>
                    <div class="hdr-camp">ARGAO CAMPUS</div>
                    <div class="hdr-addr">Ed Kintanar Street, Lamacan, Argao, Cebu</div>
                    <div class="hdr-addr">Website: http://www.argao.ctu.edu.ph &nbsp;&nbsp; E-mail: cdargao@ctu.edu.ph</div>
                    <div class="hdr-addr">Phone No.: (032) 401-0737 local 1700 </div>
                </div>
                <img class="hdr-logo" src="/images/Bagong_Pilipinas_logo.png" alt="BP" />
            </div>

            <div class="card-title">DEPARTMENTAL CLEARANCE</div>
            <div class="sem-line">@Html.Raw(FillLine(sem)) Sem, AY @Html.Raw(FillLine(ay))</div>

            <!-- STUDENT INFO -->
            <table class="info3">
                <tr>
                    <td>@Html.Raw(FillLine(Model?.StudentName))</td>
                    <td>@Html.Raw(FillLine(courseSection))</td>
                    <td>@Html.Raw(FillLine(Model?.StudentId))</td>
                </tr>
                <tr class="cap">
                    <td>(Name of Student)</td>
                    <td>(Course, Year &amp; Section)</td>
                    <td>ID Number</td>
                </tr>
            </table>

            <!-- SUBJECTS TABLE -->
            <table class="subj-tbl">
                <thead>
                    <tr><th colspan="2">Subjects</th><th colspan="2">Instructors/Professors</th></tr>
                    <tr>
                        <th class="col-code">Code</th>
                        <th>Title/Description</th>
                        <th class="col-name">Name</th>
                        <th class="col-sig">Signature</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var rows    = (Model?.Subjects ?? new List<OnlineClearanceSystem.Models.PdfSubjectItem>()).ToList();
                    int minRows = Math.Max(rows.Count, 10);
                    for (int i = 0; i < minRows; i++)
                    {
                        if (i < rows.Count)
                        {
                            var row = rows[i];
                            <tr>
                                <td>@row.SubjectCode</td>
                                <td>@row.Description</td>
                                <td>@(row.InstructorName == "TBA" ? "" : row.InstructorName)</td>
                                <td class="sig-cell">
                                    @if (row.Status == "Cleared" && !string.IsNullOrEmpty(row.SignatureBase64))
                                    { <img src="@row.SignatureBase64" class="sig-img" /> }
                                </td>
                            </tr>
                        }
                        else { <tr><td>&nbsp;</td><td></td><td></td><td></td></tr> }
                    }
                }
                </tbody>
            </table>

            <!-- SIGNATURES -->
            <div class="sig-section">
                <!-- LEFT: org treasurer, computer lab in-charge, class adviser -->
                <div class="sig-col sig-col-left">
                    @foreach (var item in leftSlots)
                    {
                        var cleared  = string.Equals(item.Status, "Cleared", StringComparison.OrdinalIgnoreCase);
                        var dispName = PersonDisplay(item.PersonName);
                        var hasSig   = cleared && !string.IsNullOrEmpty(item.SignatureBase64);
                        <div class="sig-block">
                            <div class="sig-line-wrap">
                                @if (hasSig) { <img src="@item.SignatureBase64" class="sig-inline-img" /> }
                                @if (!string.IsNullOrEmpty(dispName)) { <div class="sig-person">@dispName</div> }
                                else { <div class="sig-person-blank"></div> }
                            </div>
                            <div class="sig-role">@((item.OrgName ?? "").ToUpperInvariant())</div>
                        </div>
                    }
                    @{
                        var advCleared  = classAdviser != null && string.Equals(classAdviser.Status, "Cleared", StringComparison.OrdinalIgnoreCase);
                        var advDispName = PersonDisplay(classAdviser?.PersonName);
                        var advHasSig   = advCleared && !string.IsNullOrEmpty(classAdviser?.SignatureBase64);
                    }
                    <div class="sig-block">
                        <div class="sig-line-wrap">
                            @if (advHasSig) { <img src="@classAdviser!.SignatureBase64" class="sig-inline-img" /> }
                            @if (!string.IsNullOrEmpty(advDispName)) { <div class="sig-person">@advDispName</div> }
                            else { <div class="sig-person-blank"></div> }
                        </div>
                        <div class="sig-role">CLASS ADVISER</div>
                    </div>
                </div>

                <!-- RIGHT: student's signature, organization adviser, department chairperson -->
                <div class="sig-col sig-col-right">

                    @{ var studentSig = Model?.SignaturePath ?? ""; var studentName = Model?.StudentName ?? ""; }
                    <div class="sig-block">
                        <div class="sig-line-wrap">
                            @if (!string.IsNullOrEmpty(studentSig)) { <img src="@studentSig" class="sig-inline-img" /> }
                            @if (!string.IsNullOrEmpty(studentName)) { <div class="sig-person">@studentName</div> }
                            else { <div class="sig-person-blank"></div> }
                        </div>
                        <div class="sig-role">STUDENT'S SIGNATURE</div>
                    </div>

                    @{
                        var orgAdviser = orgList.FirstOrDefault(o =>
                            string.Equals(o.OrgName, "Organization Adviser", StringComparison.OrdinalIgnoreCase));
                        var oaCleared  = orgAdviser != null && string.Equals(orgAdviser.Status, "Cleared", StringComparison.OrdinalIgnoreCase);
                        var oaDispName = PersonDisplay(orgAdviser?.PersonName);
                        var oaHasSig   = oaCleared && !string.IsNullOrEmpty(orgAdviser?.SignatureBase64);
                    }
                    <div class="sig-block">
                        <div class="sig-line-wrap">
                            @if (oaHasSig) { <img src="@orgAdviser!.SignatureBase64" class="sig-inline-img" /> }
                            @if (!string.IsNullOrEmpty(oaDispName)) { <div class="sig-person">@oaDispName</div> }
                            else { <div class="sig-person-blank"></div> }
                        </div>
                        <div class="sig-role">ORGANIZATION ADVISER</div>
                    </div>

                    @{
                        var dcCleared  = deptChair != null && string.Equals(deptChair.Status, "Cleared", StringComparison.OrdinalIgnoreCase);
                        var dcDispName = PersonDisplay(deptChair?.PersonName);
                        var dcHasSig   = dcCleared && !string.IsNullOrEmpty(deptChair?.SignatureBase64);
                    }
                    <div class="sig-block">
                        <div class="sig-line-wrap">
                            @if (dcHasSig) { <img src="@deptChair!.SignatureBase64" class="sig-inline-img" /> }
                            @if (!string.IsNullOrEmpty(dcDispName)) { <div class="sig-person">@dcDispName</div> }
                            else { <div class="sig-person-blank"></div> }
                        </div>
                        <div class="sig-role">DEPARTMENT CHAIRPERSON</div>
                    </div>

                </div>
            </div>
        </section>
    }
}

@{ RenderCard(); }
<div class="copy-divider">— — — — — — — — STUDENT'S COPY — — — — — — — —</div>
@{ RenderCard(); }
<div class="rankings-footer">
    <img src="/images/university_rankings.png" alt="University Rankings" />
</div>

</div><!-- /#sheet -->
</div><!-- /#pdf-preview -->

@section Scripts {
<script>
/* ══════════════════════════════════════════
   PERIOD DROPDOWN — data baked in from server (same approach as Clearance page)
══════════════════════════════════════════ */
const _serverPeriodId = @(Model?.ActivePeriodId ?? 0);
const allPeriods = @Html.Raw(periodsJson);

function buildPeriodDropdown() {
    const dd = document.getElementById('period-dd');
    dd.innerHTML = '';

    if (!allPeriods || !allPeriods.length) {
        dd.innerHTML = '<div style="padding:20px;text-align:center;font-size:12px;color:#aaa;">No academic periods found.</div>';
        return;
    }

    // Update button display to match server-selected period
    const active = allPeriods.find(p => p.id === _serverPeriodId) ?? allPeriods[0];
    document.getElementById('period-btn-value').textContent = `${active.sem}, A.Y. ${active.ay}`;

    allPeriods.forEach(p => {
        const opt     = document.createElement('div');
        opt.className = 'pd-opt' + (p.id === _serverPeriodId ? ' selected' : '');
        opt.innerHTML = `<span style="flex:1;">${esc(p.sem)}, A.Y. ${esc(p.ay)}</span>
                         <i class="fas fa-check pd-check"></i>`;
        opt.onclick = (e) => {
            e.stopPropagation();
            window.location.href = '/Student/DownloadPdf?periodId=' + p.id;
        };
        dd.appendChild(opt);
    });
}

function togglePeriodDd(e) {
    e.stopPropagation();
    document.getElementById('period-wrap').classList.toggle('open');
}

document.addEventListener('click', function(e) {
    const wrap = document.getElementById('period-wrap');
    if (wrap && !wrap.contains(e.target)) wrap.classList.remove('open');
});

function esc(s) {
    return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

/* ── Init ── */
buildPeriodDropdown();

/* ══════════════════════════════════════════
   FIT TO PAGE
══════════════════════════════════════════ */
let isFitted = true;

function fitToPage() {
    const preview = document.getElementById("pdf-preview");
    const sheet   = document.getElementById("sheet");
    if (!preview || !sheet) return;

    if (isFitted) {
        const pageWidth  = preview.clientWidth - 40;
        const a4WidthPx  = 210 * 3.7795275591;
        const scale      = pageWidth / a4WidthPx;
        const finalScale = Math.min(scale, 1);

        sheet.style.transform       = `scale(${finalScale})`;
        sheet.style.transformOrigin = "top left";
        sheet.style.marginBottom    = "0";

        const scaledHeight = sheet.scrollHeight * finalScale;
        preview.style.height = (scaledHeight + 40) + "px";
    } else {
        sheet.style.transform    = "scale(1)";
        sheet.style.marginBottom = "0";
        preview.style.height     = "auto";
    }
}

window.addEventListener("load", () => {
    fitToPage();
});
window.addEventListener("resize", fitToPage);

function doPrint() {
    window.print();
}
</script>
}
