@{
    ViewData["Title"]      = "Subjects";
    ViewData["ActivePage"] = "Subjects";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <div class="stat-num" id="stat-subjects">0</div>
                <div class="stat-label">Total Subjects</div>
            </div>
            <div class="stat-icon-wrap si-blue"><i class="fas fa-book"></i></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div>
                <div class="stat-num" id="stat-offered">0</div>
                <div class="stat-label">Subjects Offered</div>
            </div>
            <div class="stat-icon-wrap si-green"><i class="fas fa-check-circle"></i></div>
        </div>
    </div>
</div>

<!-- All Subjects Panel -->
<div class="panel mb-4">
    <div class="panel-hd">
        <span class="panel-hd-title"><i class="fas fa-book me-2"></i>Subjects</span>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <div class="search-wrap">
                <i class="fas fa-search"></i>
                <input class="search-input" placeholder="Search Subject, MIS, Code, Instructor" oninput="filterTable(this,'subj-table')" />
            </div>
            <button class="btn-green-sm" onclick="openCsvModal()">
                <i class="fas fa-file-csv me-1"></i>Import CSV
            </button>
            <button class="btn-green-sm" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
                <i class="fas fa-plus me-1"></i>Add Subject
            </button>
        </div>
    </div>

    <!-- Bulk Action Bar (hidden until rows selected) -->
    <div id="bulk-bar" style="display:none;align-items:center;gap:10px;padding:10px 16px;background:rgba(66,153,225,0.08);border-bottom:1px solid var(--border);flex-wrap:wrap;">
        <span id="bulk-count" style="font-size:13px;font-weight:700;color:var(--text);"></span>
        <button onclick="bulkDeactivate()"
                style="background:#d69e2e;color:#fff;border:none;border-radius:7px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;">
            <i class="fas fa-ban"></i>Deactivate Selected
        </button>
        <button onclick="openBulkDeleteModal()"
                style="background:#e53e3e;color:#fff;border:none;border-radius:7px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;">
            <i class="fas fa-trash"></i>Delete Selected
        </button>
        <button onclick="clearSelection()"
                style="background:rgba(255,255,255,0.07);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:6px 14px;font-size:12px;cursor:pointer;">
            Cancel
        </button>
    </div>

    <div class="table-responsive">
        <table class="data-table" id="subj-table">
            <thead>
                <tr>
                    <th style="width:42px;text-align:center;">
                        <input type="checkbox" id="select-all" onchange="toggleSelectAll(this)"
                               style="width:15px;height:15px;cursor:pointer;accent-color:#4299e1;" />
                    </th>
                    <th>MIS Code</th>
                    <th>Subject Code</th>
                    <th>Description</th>
                    <th>Lec Units</th>
                    <th>Lab Units</th>
                    <th>Assigned Instructor</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="subj-body"></tbody>
        </table>
    </div>
    <div id="subj-empty" style="padding:48px 24px;text-align:center;">
        <div style="width:64px;height:64px;border-radius:50%;background:rgba(66,153,225,0.10);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <i class="fas fa-book-open" style="font-size:26px;color:#4299e1;opacity:0.7;"></i>
        </div>
        <div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:6px;">No Subjects Added Yet</div>
        <div style="font-size:12px;color:var(--muted);max-width:360px;margin:0 auto;line-height:1.6;">
            Use the <strong style="color:var(--text);">Add Subject</strong> button above to create subjects.
        </div>
    </div>
</div>

<!-- ADD SUBJECT MODAL -->
<div class="modal fade modal-dark" id="addSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-book me-2" style="color:#4299e1;"></i>Add Subject</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="dark-label">MIS Code</label><input class="dark-input" id="add-mis" placeholder="e.g. GT-60" /></div>
                <div class="mb-3"><label class="dark-label">Subject Code</label><input class="dark-input" id="add-code" placeholder="e.g. GEC" /></div>
                <div class="mb-3"><label class="dark-label">Description</label><input class="dark-input" id="add-desc" placeholder="e.g. History" /></div>
                <div class="mb-3">
                    <label class="dark-label">Lec Unit</label>
                    <select class="dark-input dark-select" id="add-lec">
                        @for (int u = 0; u <= 5; u++) { <option value="@u">@u</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="dark-label">Lab Unit</label>
                    <select class="dark-input dark-select" id="add-lab">
                        @for (int u = 0; u <= 5; u++) { <option value="@u">@u</option> }
                    </select>
                </div>
                <button class="btn-blue-sm w-100" onclick="addSubject()">
                    <i class="fas fa-save me-1"></i>Save Subject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT SUBJECT MODAL -->
<div class="modal fade modal-dark" id="editSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit me-2" style="color:#4299e1;"></i>Edit Subject</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-subj-idx" />
                <div class="mb-3"><label class="dark-label">MIS Code</label><input class="dark-input" id="edit-mis" placeholder="e.g. GT-60" /></div>
                <div class="mb-3"><label class="dark-label">Subject Code</label><input class="dark-input" id="edit-code" placeholder="e.g. GEC" /></div>
                <div class="mb-3"><label class="dark-label">Description</label><input class="dark-input" id="edit-desc" placeholder="e.g. History" /></div>
                <div class="mb-3">
                    <label class="dark-label">Lec Unit</label>
                    <select class="dark-input dark-select" id="edit-lec">
                        @for (int u = 0; u <= 5; u++) { <option value="@u">@u</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="dark-label">Lab Unit</label>
                    <select class="dark-input dark-select" id="edit-lab">
                        @for (int u = 0; u <= 5; u++) { <option value="@u">@u</option> }
                    </select>
                </div>
                <button class="btn-blue-sm w-100" onclick="saveEditSubject()">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- OFFER SUBJECT MODAL -->
<div class="modal fade modal-dark" id="offerSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2" style="color:#38a169;"></i>Offer Subject</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="dark-label">MIS Code</label><input class="dark-input" id="offer-mis" readonly /></div>
                <div class="mb-3"><label class="dark-label">Subject Code</label><input class="dark-input" id="offer-code" readonly /></div>
                <div class="mb-3"><label class="dark-label">Description</label><input class="dark-input" id="offer-desc" readonly /></div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="dark-label">Lec Units</label><input class="dark-input" id="offer-lec" readonly /></div>
                    <div class="col-6"><label class="dark-label">Lab Units</label><input class="dark-input" id="offer-lab" readonly /></div>
                </div>
                <div class="mb-4">
                    <label class="dark-label">Assign Instructor</label>
                    <select class="dark-input dark-select" id="offer-inst">
                        <option value="">-- Select Instructor --</option>
                    </select>
                </div>
                <div style="background:rgba(66,153,225,0.08);border:1px solid rgba(66,153,225,0.25);border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--muted);display:flex;gap:8px;">
                    <i class="fas fa-info-circle" style="color:#4299e1;margin-top:2px;flex-shrink:0;"></i>
                    <span>Only registered instructors will appear once they complete registration.</span>
                </div>
                <button class="btn-blue-sm w-100" onclick="addToOffered()">
                    <i class="fas fa-check me-1"></i>Confirm &amp; Offer
                </button>
            </div>
            <input type="hidden" id="offer-subj-id" />
        </div>
    </div>
</div>

<!-- DELETE CONFIRM MODAL (single + bulk) -->
<div id="delete-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:14px;padding:28px;width:100%;max-width:380px;margin:16px;text-align:center;">
        <div style="width:56px;height:56px;border-radius:50%;background:rgba(229,62,62,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <i class="fas fa-trash" style="font-size:22px;color:#fc8181;"></i>
        </div>
        <div style="font-size:15px;font-weight:700;margin-bottom:8px;" id="delete-modal-title">Delete?</div>
        <div style="font-size:13px;color:var(--muted);margin-bottom:24px;" id="delete-modal-body">This cannot be undone.</div>
        <div class="d-flex justify-content-center gap-3">
            <button onclick="closeDeleteModal()" style="background:rgba(255,255,255,0.07);border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:8px 22px;font-size:13px;cursor:pointer;">Cancel</button>
            <button onclick="confirmDelete()" style="background:#e53e3e;border:none;color:white;border-radius:8px;padding:8px 22px;font-size:13px;font-weight:700;cursor:pointer;">
                <i class="fas fa-trash me-1"></i>Delete
            </button>
        </div>
    </div>
</div>

<!-- CSV IMPORT MODAL -->
<div id="csv-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:14px;width:100%;max-width:700px;margin:16px;max-height:90vh;display:flex;flex-direction:column;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
            <div style="font-size:15px;font-weight:800;color:var(--text);">
                <i class="fas fa-file-csv me-2" style="color:#38a169;"></i>Import Subjects from CSV
            </div>
            <button onclick="closeCsvModal()" style="background:none;border:none;font-size:18px;color:var(--muted);cursor:pointer;line-height:1;">&times;</button>
        </div>
        <div style="padding:20px 24px;overflow-y:auto;flex:1;">
            <div style="background:rgba(66,153,225,0.08);border:1px solid rgba(66,153,225,0.25);border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:12px;color:var(--muted);line-height:1.7;">
                <strong style="color:var(--text);">Expected CSV format (with or without header row):</strong><br>
                <code style="font-size:11px;color:#4299e1;">MIS Code, Subject Code, Description, Lec Units, Lab Units</code><br>
                Rows with duplicate MIS + Subject Code will be skipped automatically.
                <span onclick="downloadTemplate()" style="color:#38a169;cursor:pointer;font-weight:700;margin-left:8px;">
                    <i class="fas fa-download me-1"></i>Download Template
                </span>
            </div>
            <div id="csv-drop-zone"
                 style="border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;cursor:pointer;transition:border-color 0.2s;margin-bottom:16px;"
                 onclick="document.getElementById('csv-file-input').click()"
                 ondragover="event.preventDefault();this.style.borderColor='#38a169';"
                 ondragleave="this.style.borderColor='';"
                 ondrop="handleCsvDrop(event)">
                <i class="fas fa-cloud-upload-alt" style="font-size:28px;color:var(--muted);margin-bottom:8px;display:block;"></i>
                <div style="font-size:13px;font-weight:600;color:var(--text);">Click to browse or drag &amp; drop a .csv file</div>
                <div id="csv-file-name" style="font-size:11px;color:var(--muted);margin-top:4px;">No file selected</div>
            </div>
            <input type="file" id="csv-file-input" accept=".csv,text/csv" style="display:none" onchange="handleCsvFile(this.files[0])">
            <div id="csv-preview-wrap" style="display:none;">
                <div style="font-size:12px;font-weight:700;color:var(--text);margin-bottom:8px;">
                    Preview <span id="csv-preview-count" style="color:var(--muted);font-weight:400;"></span>
                </div>
                <div style="overflow-x:auto;max-height:260px;border:1px solid var(--border);border-radius:8px;">
                    <table style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead>
                            <tr style="background:var(--tbl-hd-navy, #1a2744);color:white;position:sticky;top:0;">
                                <th style="padding:7px 10px;text-align:left;">MIS Code</th>
                                <th style="padding:7px 10px;text-align:left;">Subject Code</th>
                                <th style="padding:7px 10px;text-align:left;">Description</th>
                                <th style="padding:7px 10px;text-align:center;">Lec</th>
                                <th style="padding:7px 10px;text-align:center;">Lab</th>
                                <th style="padding:7px 10px;text-align:center;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="csv-preview-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div style="padding:16px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:10px;flex-shrink:0;">
            <button onclick="closeCsvModal()" style="background:rgba(255,255,255,0.07);border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:8px 22px;font-size:13px;cursor:pointer;">Cancel</button>
            <button id="csv-import-btn" onclick="runCsvImport()" disabled
                    style="background:#38a169;border:none;color:white;border-radius:8px;padding:8px 22px;font-size:13px;font-weight:700;cursor:pointer;opacity:0.5;">
                <i class="fas fa-file-import me-1"></i>Import
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let subjects     = [];
let offered      = [];
let courses      = [];
let deleteTarget = null; // { type: 'single'|'bulk', idx?: number }

// ── Selection state ───────────────────────────────────────────────────────────
const selectedIds = new Set(); // stores subject index (array position)

function getSelectedIndices() {
    return [...selectedIds];
}

function updateBulkBar() {
    const bar   = document.getElementById('bulk-bar');
    const count = selectedIds.size;
    if (count === 0) {
        bar.style.display = 'none';
    } else {
        bar.style.display = 'flex';
        document.getElementById('bulk-count').textContent =
            `${count} subject${count > 1 ? 's' : ''} selected`;
    }
    // Keep select-all checkbox in sync
    const allCbs = document.querySelectorAll('.row-cb');
    const sa     = document.getElementById('select-all');
    if (sa) {
        sa.indeterminate = count > 0 && count < allCbs.length;
        sa.checked       = allCbs.length > 0 && count === allCbs.length;
    }
}

function toggleSelectAll(master) {
    document.querySelectorAll('.row-cb').forEach(cb => {
        cb.checked = master.checked;
        const idx  = parseInt(cb.dataset.idx);
        if (master.checked) selectedIds.add(idx);
        else                selectedIds.delete(idx);
        // highlight row
        cb.closest('tr').style.background = master.checked
            ? 'rgba(66,153,225,0.07)' : '';
    });
    updateBulkBar();
}

function toggleRowSelect(cb) {
    const idx = parseInt(cb.dataset.idx);
    if (cb.checked) selectedIds.add(idx);
    else            selectedIds.delete(idx);
    cb.closest('tr').style.background = cb.checked
        ? 'rgba(66,153,225,0.07)' : '';
    updateBulkBar();
}

function clearSelection() {
    selectedIds.clear();
    document.querySelectorAll('.row-cb').forEach(cb => {
        cb.checked = false;
        cb.closest('tr').style.background = '';
    });
    const sa = document.getElementById('select-all');
    if (sa) { sa.checked = false; sa.indeterminate = false; }
    updateBulkBar();
}

// ── Bulk actions ──────────────────────────────────────────────────────────────
async function bulkDeactivate() {
    const indices = getSelectedIndices();
    if (!indices.length) return;

    // Only deactivate rows that actually have an active offering
    const toDeactivate = indices
        .map(i => subjects[i])
        .map(s => offered.find(o => o.code === s.code && o.mis === s.mis && o.active))
        .filter(Boolean);

    if (!toDeactivate.length) {
        alert('None of the selected subjects have an active offering to deactivate.');
        return;
    }
    if (!confirm(`Deactivate ${toDeactivate.length} active offering(s)? This can be re-offered later.`)) return;

    for (const ofr of toDeactivate) {
        await fetch(`/api/admin/subject-offerings/${ofr.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ active: false })
        });
    }
    const oRes = await fetch('/api/admin/subject-offerings');
    offered    = await oRes.json();
    clearSelection();
    renderSubjects();
    updateStats();
}

function openBulkDeleteModal() {
    const indices = getSelectedIndices();
    if (!indices.length) return;
    deleteTarget = { type: 'bulk' };
    const n = indices.length;
    document.getElementById('delete-modal-title').textContent = `Delete ${n} Subject${n > 1 ? 's' : ''}?`;
    document.getElementById('delete-modal-body').textContent  =
        `${n} subject${n > 1 ? 's' : ''} will be permanently removed along with their offerings. This cannot be undone.`;
    document.getElementById('delete-modal').style.display = 'flex';
}

// ── Data & render ─────────────────────────────────────────────────────────────
async function init() {
    try {
        const [sRes, oRes, iRes] = await Promise.all([
            fetch('/api/admin/subjects'),
            fetch('/api/admin/subject-offerings'),
            fetch('/api/admin/instructors')
        ]);
        subjects = await sRes.json();
        offered  = await oRes.json();
        const instList = await iRes.json();
        populateInstructors(instList);
    } catch (e) {
        console.error('Init error:', e);
    }
    renderSubjects();
    updateStats();
}

function populateInstructors(instList) {
    const sel = document.getElementById('offer-inst');
    sel.innerHTML = '<option value="">-- Select Instructor --</option>';
    instList.forEach(i => {
        const opt = document.createElement('option');
        opt.value = i.id;
        opt.textContent = i.name + (i.employeeId !== '—' ? ` (${i.employeeId})` : '');
        sel.appendChild(opt);
    });
}

function updateStats() {
    document.getElementById('stat-subjects').textContent = subjects.length;
    document.getElementById('stat-offered').textContent  = offered.length;
}

function renderSubjects() {
    const tbody = document.getElementById('subj-body');
    const empty = document.getElementById('subj-empty');
    tbody.innerHTML = '';

    // Reset select-all when re-rendering
    const sa = document.getElementById('select-all');
    if (sa) { sa.checked = false; sa.indeterminate = false; }

    if (!subjects.length) { empty.style.display = 'block'; updateStats(); return; }
    empty.style.display = 'none';

    subjects.forEach((s, i) => {
        const ofr = offered.find(o => o.code === s.code && o.mis === s.mis && o.active);
        const instInitial = (ofr && ofr.inst && ofr.inst !== '—') ? ofr.inst.charAt(0) : '?';
        const instLabel   = (ofr && ofr.inst && ofr.inst !== '—')
            ? escHtml(ofr.inst)
            : '<span style="color:var(--muted);font-style:italic;">Not assigned</span>';
        const instHtml = ofr
            ? `<div class="d-flex align-items-center gap-2">
                   <div class="user-avatar-sm" style="background:#4299e1;font-size:11px;">${escHtml(instInitial)}</div>
                   ${instLabel}
               </div>`
            : `<span style="color:var(--muted);">—</span>`;
        const offerActionHtml = ofr
            ? `<button style="background:#e53e3e;color:#fff;border:none;border-radius:6px;padding:5px 12px;font-size:12px;font-weight:600;cursor:pointer;"
                   onclick="toggleStatus(${ofr.id},'deactivate')">
                   <i class="fas fa-ban me-1"></i>Deactivate
               </button>`
            : `<button style="background:#38a169;color:#fff;border:none;border-radius:6px;padding:5px 14px;font-size:12px;font-weight:600;cursor:pointer;"
                   data-bs-toggle="modal" data-bs-target="#offerSubjectModal"
                   onclick="setOfferSubject(${i})">
                   <i class="fas fa-plus me-1"></i>Offer
               </button>`;

        const isChecked = selectedIds.has(i);
        const rowBg     = isChecked ? 'background:rgba(66,153,225,0.07);' : '';

        const tr = document.createElement('tr');
        tr.style.cssText = rowBg;
        tr.innerHTML = `
            <td style="text-align:center;vertical-align:middle;">
                <input type="checkbox" class="row-cb" data-idx="${i}"
                       ${isChecked ? 'checked' : ''}
                       onchange="toggleRowSelect(this)"
                       style="width:15px;height:15px;cursor:pointer;accent-color:#4299e1;" />
            </td>
            <td style="color:var(--muted);">${escHtml(s.mis)}</td>
            <td style="font-weight:600;">${escHtml(s.code)}</td>
            <td>${escHtml(s.desc)}</td>
            <td style="text-align:center;">${s.lec}</td>
            <td style="text-align:center;">${s.lab}</td>
            <td>${instHtml}</td>
            <td>
                <div class="d-flex gap-2 align-items-center">
                    <button style="background:#4299e1;color:#fff;border:none;border-radius:6px;padding:5px 14px;font-size:12px;font-weight:600;cursor:pointer;"
                        onclick="openEditSubject(${i})">
                        <i class="fas fa-edit me-1"></i>Edit
                    </button>
                    ${offerActionHtml}
                    <button onclick="openDeleteModal('subject',${i})"
                        style="background:rgba(229,62,62,0.12);color:#fc8181;border:none;border-radius:6px;padding:5px 12px;font-size:12px;cursor:pointer;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </td>`;
        tbody.appendChild(tr);
    });
    updateStats();
    updateBulkBar();
}

// ── Subject CRUD ──────────────────────────────────────────────────────────────
async function addSubject() {
    const mis  = document.getElementById('add-mis').value.trim();
    const code = document.getElementById('add-code').value.trim();
    const desc = document.getElementById('add-desc').value.trim();
    const lec  = parseInt(document.getElementById('add-lec').value);
    const lab  = parseInt(document.getElementById('add-lab').value);
    if (!mis || !code || !desc) { alert('Please fill in MIS Code, Subject Code, and Description.'); return; }
    const res  = await fetch('/api/admin/subjects', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mis, code, desc, lec, lab })
    });
    const data = await res.json();
    if (data.success) {
        subjects.push({ id: data.id, mis, code, desc, lec, lab });
        renderSubjects();
        document.getElementById('add-mis').value  = '';
        document.getElementById('add-code').value = '';
        document.getElementById('add-desc').value = '';
        bootstrap.Modal.getInstance(document.getElementById('addSubjectModal')).hide();
    } else {
        alert('Error saving subject: ' + (data.error || 'Unknown error'));
    }
}

function openEditSubject(idx) {
    const s = subjects[idx];
    document.getElementById('edit-subj-idx').value = idx;
    document.getElementById('edit-mis').value  = s.mis;
    document.getElementById('edit-code').value = s.code;
    document.getElementById('edit-desc').value = s.desc;
    document.getElementById('edit-lec').value  = s.lec;
    document.getElementById('edit-lab').value  = s.lab;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('editSubjectModal')).show();
}

async function saveEditSubject() {
    const idx  = parseInt(document.getElementById('edit-subj-idx').value);
    const mis  = document.getElementById('edit-mis').value.trim();
    const code = document.getElementById('edit-code').value.trim();
    const desc = document.getElementById('edit-desc').value.trim();
    const lec  = parseInt(document.getElementById('edit-lec').value);
    const lab  = parseInt(document.getElementById('edit-lab').value);
    if (!mis || !code || !desc) { alert('Please fill in MIS Code, Subject Code, and Description.'); return; }
    const id  = subjects[idx].id;
    const res = await fetch(`/api/admin/subjects/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mis, code, desc, lec, lab })
    });
    const data = await res.json();
    if (data.success) {
        subjects[idx] = { ...subjects[idx], mis, code, desc, lec, lab };
        renderSubjects();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('editSubjectModal')).hide();
    } else {
        alert('Error updating subject: ' + (data.error || 'Unknown error'));
    }
}

function setOfferSubject(idx) {
    const s = subjects[idx];
    document.getElementById('offer-mis').value  = s.mis;
    document.getElementById('offer-code').value = s.code;
    document.getElementById('offer-desc').value = s.desc;
    document.getElementById('offer-lec').value  = s.lec;
    document.getElementById('offer-lab').value  = s.lab;
    document.getElementById('offer-inst').value = '';
    document.getElementById('offer-subj-id').value = s.id;
}

async function addToOffered() {
    const instVal = document.getElementById('offer-inst').value;
    if (!instVal) { alert('Please assign an instructor first.'); return; }
    const payload = {
        subjId: parseInt(document.getElementById('offer-subj-id').value),
        mis:  document.getElementById('offer-mis').value,
        inst: parseInt(instVal)
    };
    const res  = await fetch('/api/admin/subject-offerings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
        const oRes = await fetch('/api/admin/subject-offerings');
        offered    = await oRes.json();
        renderSubjects();
        updateStats();
        bootstrap.Modal.getInstance(document.getElementById('offerSubjectModal')).hide();
    } else {
        alert('Error: ' + (data.error || 'Could not offer subject'));
    }
}

async function toggleStatus(offeringId, action) {
    if (!confirm(`Are you sure you want to ${action} this subject offering?`)) return;
    const res  = await fetch(`/api/admin/subject-offerings/${offeringId}`, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ active: action !== 'deactivate' })
    });
    const data = await res.json();
    if (data.success) {
        offered = offered.filter(o => o.id !== offeringId);
        renderSubjects();
        updateStats();
    } else {
        alert('Error: ' + (data.error || 'Unknown error'));
    }
}

// ── Delete modal (single + bulk) ──────────────────────────────────────────────
function openDeleteModal(type, idx) {
    deleteTarget = { type: 'single', idx };
    document.getElementById('delete-modal-title').textContent = 'Delete Subject?';
    document.getElementById('delete-modal-body').textContent  = 'This subject will be permanently removed. This cannot be undone.';
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');
    document.getElementById('delete-modal').style.display = 'flex';
}

function closeDeleteModal() {
    document.getElementById('delete-modal').style.display = 'none';
    deleteTarget = null;
}

async function confirmDelete() {
    if (!deleteTarget) return;

    if (deleteTarget.type === 'single') {
        await deleteSingle(deleteTarget.idx);
    } else if (deleteTarget.type === 'bulk') {
        await deleteBulk();
    }
    closeDeleteModal();
}

async function deleteSingle(idx) {
    const id       = subjects[idx].id;
    const subjCode = subjects[idx].code;
    const hasActive = offered.some(o => o.code === subjCode && (o.active === true || o.active === 1));
    if (hasActive) {
        alert('Cannot delete this subject while it is still Active in Subjects Offered. Please deactivate it first.');
        return;
    }
    const toRemove = offered.filter(o => o.code === subjCode);
    for (const o of toRemove) {
        await fetch(`/api/admin/subject-offerings/${o.id}`, { method: 'DELETE' });
    }
    const res  = await fetch(`/api/admin/subjects/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
        subjects.splice(idx, 1);
        offered = offered.filter(o => o.code !== subjCode);
        selectedIds.clear();
        renderSubjects();
        updateStats();
    } else {
        alert('Error: ' + (data.error || 'Could not delete subject'));
    }
}

async function deleteBulk() {
    const indices = getSelectedIndices().sort((a, b) => b - a); // descending so splicing is safe
    const blocked = [];
    const toDelete = [];

    for (const idx of indices) {
        const s         = subjects[idx];
        const hasActive = offered.some(o => o.code === s.code && (o.active === true || o.active === 1));
        if (hasActive) { blocked.push(s.code); continue; }
        toDelete.push(idx);
    }

    if (blocked.length) {
        alert(`The following subjects are still active and were skipped:\n${blocked.join(', ')}\n\nPlease deactivate them first.`);
    }

    for (const idx of toDelete) {
        const s = subjects[idx];
        const toRemove = offered.filter(o => o.code === s.code);
        for (const o of toRemove) {
            await fetch(`/api/admin/subject-offerings/${o.id}`, { method: 'DELETE' });
        }
        await fetch(`/api/admin/subjects/${s.id}`, { method: 'DELETE' });
    }

    // Rebuild arrays by removing deleted indices
    const deletedSet = new Set(toDelete);
    subjects = subjects.filter((_, i) => !deletedSet.has(i));
    offered  = offered.filter(o => !subjects.every(s => s.code !== o.code)); // keep only still-existing
    const oRes = await fetch('/api/admin/subject-offerings');
    offered = await oRes.json();

    selectedIds.clear();
    renderSubjects();
    updateStats();
}

document.getElementById('delete-modal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});

// ── CSV IMPORT ────────────────────────────────────────────────────────────────
let csvRows = [];

function openCsvModal() {
    csvRows = [];
    document.getElementById('csv-file-input').value = '';
    document.getElementById('csv-file-name').textContent = 'No file selected';
    document.getElementById('csv-preview-wrap').style.display = 'none';
    document.getElementById('csv-import-btn').disabled = true;
    document.getElementById('csv-import-btn').style.opacity = '0.5';
    document.getElementById('csv-modal').style.display = 'flex';
}
function closeCsvModal() {
    document.getElementById('csv-modal').style.display = 'none';
}
document.getElementById('csv-modal').addEventListener('click', function(e) {
    if (e.target === this) closeCsvModal();
});
function handleCsvDrop(e) {
    e.preventDefault();
    document.getElementById('csv-drop-zone').style.borderColor = '';
    const file = e.dataTransfer.files[0];
    if (file) handleCsvFile(file);
}
function handleCsvFile(file) {
    if (!file) return;
    document.getElementById('csv-file-name').textContent = file.name;
    const reader = new FileReader();
    reader.onload = function(ev) { parseCsvText(ev.target.result); };
    reader.readAsText(file);
}
function parseCsvText(text) {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
    csvRows = [];
    const headerKeywords = ['mis', 'subject', 'code', 'description', 'lec', 'lab'];
    let startIdx = 0;
    if (lines.length > 0) {
        const firstLow = lines[0].toLowerCase();
        if (headerKeywords.some(k => firstLow.includes(k))) startIdx = 1;
    }
    for (let i = startIdx; i < lines.length; i++) {
        const cols = splitCsvLine(lines[i]);
        const mis  = (cols[0] || '').trim();
        const code = (cols[1] || '').trim();
        const desc = (cols[2] || '').trim();
        const lec  = parseInt(cols[3] || '0') || 0;
        const lab  = parseInt(cols[4] || '0') || 0;
        const isDup = subjects.some(s => s.mis === mis && s.code === code);
        csvRows.push({ mis, code, desc, lec, lab, dup: isDup, valid: !!(mis && code) });
    }
    renderCsvPreview();
}
function splitCsvLine(line) {
    const result = [];
    let cur = '', inQ = false;
    for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') { inQ = !inQ; }
        else if (ch === ',' && !inQ) { result.push(cur); cur = ''; }
        else { cur += ch; }
    }
    result.push(cur);
    return result;
}
function renderCsvPreview() {
    const tbody = document.getElementById('csv-preview-body');
    tbody.innerHTML = '';
    const validCount = csvRows.filter(r => r.valid && !r.dup).length;
    document.getElementById('csv-preview-count').textContent =
        `— ${csvRows.length} rows parsed, ${validCount} will be imported`;
    csvRows.forEach(r => {
        const tr = document.createElement('tr');
        let statusHtml, rowStyle = '';
        if (!r.valid) {
            statusHtml = `<span style="color:#fc8181;font-weight:700;font-size:11px;">Invalid</span>`;
            rowStyle = 'background:rgba(229,62,62,0.05);';
        } else if (r.dup) {
            statusHtml = `<span style="color:#f6ad55;font-weight:700;font-size:11px;">Duplicate</span>`;
            rowStyle = 'background:rgba(246,173,85,0.07);';
        } else {
            statusHtml = `<span style="color:#68d391;font-weight:700;font-size:11px;">Ready</span>`;
        }
        tr.style.cssText = 'border-bottom:1px solid var(--border);' + rowStyle;
        tr.innerHTML = `
            <td style="padding:6px 10px;color:var(--muted);">${escHtml(r.mis)}</td>
            <td style="padding:6px 10px;font-weight:600;">${escHtml(r.code)}</td>
            <td style="padding:6px 10px;">${escHtml(r.desc)}</td>
            <td style="padding:6px 10px;text-align:center;">${r.lec}</td>
            <td style="padding:6px 10px;text-align:center;">${r.lab}</td>
            <td style="padding:6px 10px;text-align:center;">${statusHtml}</td>`;
        tbody.appendChild(tr);
    });
    document.getElementById('csv-preview-wrap').style.display = 'block';
    const btn = document.getElementById('csv-import-btn');
    btn.disabled = validCount === 0;
    btn.style.opacity = validCount > 0 ? '1' : '0.5';
}
async function runCsvImport() {
    const toImport = csvRows.filter(r => r.valid && !r.dup);
    if (!toImport.length) return;
    const btn = document.getElementById('csv-import-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Importing…';
    const res  = await fetch('/api/admin/subjects/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows: toImport })
    });
    const data = await res.json();
    btn.innerHTML = '<i class="fas fa-file-import me-1"></i>Import';
    if (data.success) {
        closeCsvModal();
        const sRes = await fetch('/api/admin/subjects');
        subjects   = await sRes.json();
        renderSubjects();
        alert(`Import complete: ${data.inserted} subject(s) added, ${data.skipped} skipped.`);
    } else {
        alert('Import failed: ' + (data.error || 'Unknown error'));
        btn.disabled = false;
    }
}
function downloadTemplate() {
    const csv = 'MIS Code,Subject Code,Description,Lec Units,Lab Units\nGT-60,GEC 1,Understanding the Self,3,0\nGT-61,MATH 1,Mathematics in the Modern World,3,0';
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'subjects_template.csv';
    a.click();
}

// ── Utilities ─────────────────────────────────────────────────────────────────
function filterTable(input, id) {
    const q = input.value.toLowerCase();
    document.querySelectorAll('#' + id + ' tbody tr').forEach(r =>
        r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none'
    );
}
function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

init();
</script>
